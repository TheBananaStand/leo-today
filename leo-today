# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def do_POST(self):  # noqa: N802
        """The hub's action channel.

        The forwarded body's exact shape is the hub's, not this package's, and
        no doc on this box states it — so read the action name from either of
        the two spellings a reader would expect, and treat anything that is
        not `name`/`action` as the arguments. It logs what it actually got,
        which is how the next person finds out for certain.
        """
        split = urllib.parse.urlsplit(self.path)
        if split.path != "/leo/ui/action":
            return self.send_error(404)
        try:
            n = int(self.headers.get("content-length") or 0)
            raw = self.rfile.read(n).decode() if n else "{}"
            body = json.loads(raw or "{}")
            if not isinstance(body, dict):
                body = {}
        except Exception:  # noqa: BLE001 — the query is the other channel
            raw, body = "", {}
        # The QUERY carries the action, because that is the half of a
        # descriptor action the hub resolves `{…}` in. The body is read too,
        # so a caller that sends one — curl, a test, a future hub — still works.
        # MEASURED by logging what arrived, then deleting the log: a
        # `packageAction` is forwarded as {"name": "ask", "args": {...}} with
        # the person in `x-leo-user-id`. The query is read as well, and only
        # so that curl and a test can drive this without composing a body.
        q = {k: v[0] for k, v in
             urllib.parse.parse_qs(split.query, keep_blank_values=True).items()}
        name = str(body.get("name") or q.pop("name", "") or "")
        args = dict(body.get("args") if isinstance(body.get("args"), dict) else {})
        args.update(q)
        user = self.headers.get("x-leo-user-id") or ""
        print(f"today: action {name!r} args={sorted(args)} user={user or '-'}", flush=True)
        try:
            out = ui_action(name, args, user, self.headers.get("x-leo-acting-grant"))
        except Exception as e:  # noqa: BLE001 — an action never takes the page down
            print(f"today: action {name!r} failed: {type(e).__name__}: {e}", flush=True)
            out = {"ok": False, "error": type(e).__name__}
        blob = json.dumps(out).encode()
        self.send_response(200)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(blob)))
        self.end_headers()
        self.wfile.write(blob)

    def do_GET(self):  # noqa: N802
        path = self.path.split("?")[0]
        if path == "/leo/ui/data":
            body = json.dumps(payload(self.headers.get("x-leo-acting-grant"),
                                      self.headers.get("x-leo-user-id") or "")).encode()
        elif path.rstrip("/").endswith("/sky"):
            # The hero's wallpaper: the weather outside, moving. A `webPane`
            # asks for it through the hub's app proxy (`/p/today/sky`).
            # The pane asks for this the moment the page draws — often BEFORE
            # the first payload has heard from the weather. So with no scene
            # yet it draws the hour alone, and the page re-asks (`?scene`).
            scene = _scene or f"cloud-{'day' if 7 <= datetime.now().hour < 18 else 'night'}"
            if "scene" in self.path.split("?", 1)[-1]:
                blob = scene.encode()
                self.send_response(200)
                self.send_header("content-type", "text/plain")
                self.send_header("cache-control", "no-store")
                self.send_header("content-length", str(len(blob)))
                self.end_headers()
                self.wfile.write(blob)
                return
            blob = SKY_HTML.replace("__SCENE__", scene).encode()
            self.send_response(200)
            self.send_header("content-type", "text/html; charset=utf-8")
            self.send_header("cache-control", "no-store")
            self.send_header("content-length", str(len(blob)))
            self.end_headers()
            self.wfile.write(blob)
            return
        elif path in ("/leo/health", "/health"):
            body = b'{"ok":true}'
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *a):
        pass


def main():
    print(f"today: serving /leo/ui/data on :{PORT}, hub at {API}", flush=True)
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
