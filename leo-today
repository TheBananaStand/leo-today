def events(now, _act):
    start = now.replace(hour=0, minute=0, second=0, microsecond=0)
    raw = rows(graph("calendar/events", start=start.isoformat(),
                     end=(start + timedelta(days=2)).isoformat()), "events", "items")
    out = []
    for e in raw:
        raw_start = e.get("start") or e.get("start_at") or e.get("starts_at")
        t = when(raw_start)
        if not t:
            continue
        # A date with no time in it is a whole day, wherever the clock is.
        date_only = bool(re.fullmatch(r"\d{4}-\d{2}-\d{2}", str(raw_start).strip()))
        if date_only:
            t = t.replace(hour=0, minute=0)
        end = when(e.get("end") or e.get("end_at") or e.get("ends_at"))
        mins = int((end - t).total_seconds() // 60) if end and end > t else 60
        allday = date_only or mins >= 300 or (t.hour == 0 and t.minute == 0 and mins >= 180)
        # Over by more than an hour and not running: not today's business.
        if t.date() < now.date() and not (t + timedelta(minutes=mins) > now):
            continue
        cal = str(e.get("calendar") or e.get("calendar_name") or "")
        out.append({
            "id": str(e.get("id") or len(out)), "at": t, "mins": min(mins, 600),
            "title": str(e.get("title") or e.get("summary") or "Untitled"),
            "where": str(e.get("location") or "")[:60],
            "tomorrow": t.date() > now.date(), "allday": "1" if allday else "",
            "live_now": t <= now <= t + timedelta(minutes=mins),
            "tint": hue(cal) if cal else "blue",
        })
    out.sort(key=lambda r: r["at"])
    seen, unique = set(), []
    for e in out:
        key = (e["title"].strip().lower(), e["at"])
        if key in seen:
            continue
        seen.add(key)
        unique.append(e)
    return unique


def tasks(now, act):
    raw = rows(graph("reminders/items", token=act, active_only="true"), "items", "reminders")
    today = now.date()
    out = []
    for r in raw:
        if r.get("completed") or r.get("done"):
            continue
        d = when(r.get("due") or r.get("due_at") or r.get("due_date"))
        if not d or d.date() > today + timedelta(days=1):
            continue
        phrase, late = due_words(d.date(), today)
        out.append({"id": str(r.get("id") or len(out)), "title": str(r.get("title") or "Untitled"),
                    "when": phrase, "late": "1" if late else "", "sort": (today - d.date()).days})
    # Genuinely late first, then by how late; the abandoned sink.
    out.sort(key=lambda r: (not r["late"], -r["sort"]))
    return out


def notes(now, act):
    raw = rows(graph("feed/items", token=act, limit="25"), "items", "feed")
    out = []
    for n in raw:
        if n.get("dismissed") or n.get("deleted_at"):
            continue
        t = when(n.get("created_at") or n.get("created"))
        if t and (now - t) > timedelta(hours=20):
            continue
        out.append({"id": str(n.get("id") or len(out)), "title": str(n.get("title") or "Untitled"),
                    "body": str(n.get("chat_summary") or n.get("body") or "")[:200],
                    "at": t, "when": clock(t)})
    return out


NOREPLY = re.compile(r"no[-_.]?reply|do[-_.]?not[-_.]?reply|notification|mailer|bounce", re.I)
# Bulk senders: the ESP subdomains blasts go out from, and the mailbox names
# nobody is sitting behind.
BULK_ADDR = re.compile(r"@(?:email\d*|e|mail\d*|em|news|mkt|marketing|info|cs)\.|"
                       r"^(?:news|newsletter|promo|offers|deals|marketing|updates|hello|team)@", re.I)
# …and what a blast is about. A page about what is waiting on YOU has no
# business carrying an advertisement, and — the reason this matters more than
# tidiness — a marketing subject is a bag of common nouns, which is exactly
# what makes a false subject: "Black Friday SALES" and "Weekly SALES Meeting"
# share a word and nothing else.
BLAST = re.compile(r"\b(black friday|cyber monday|% off|\d+% |deals?|sale|save big|"
                   r"limited time|act now|unsubscribe|webinar|newsletter|coupon|"
                   r"info enclosed|special offer|exclusive|you(?:'re| are) invited|"
                   r"don'?t miss|last chance|ends (?:today|soon)|free trial|"
                   r"refinanc|home equity|pre-?approved|rates? (?:are|have)|"
                   r"lowest price|best price|price drop|clearance|flash)s?\b", re.I)
# A machine telling you where a parcel is is not a person waiting on you.
# This is its own pattern rather than more BLAST entries because it is a
# different KIND of thing — transactional, not promotional — and lumping
# them together is how the next reader mis-tunes one by editing the other.
RECEIPT = re.compile(r"\b(tracking (?:added|number|update)|your order|order (?:#|confirm|ship|"
                     r"placed|update)|has shipped|out for delivery|delivered|receipt|"
                     r"invoice|statement (?:is|available)|payment (?:received|confirm)|"
                     r"shipping confirmation|we'?ve received)\b", re.I)
FROM = re.compile(r'^\s*"?(?P<name>[^"<]{1,60}?)"?\s*<(?P<addr>[^>]+)>\s*$')


def sender(raw):
    """The person, out of `"Name" <addr>` — or the mailbox when there is no name."""
    m = FROM.match(str(raw or ""))
    if m:
        name = m.group("name").strip(" ,")
        return (name or m.group("addr").split("@")[0]), m.group("addr")
    raw = str(raw or "").strip()
    return (raw.split("@")[0] or raw), raw


def mail(now, act):
    """What is waiting on a reply.

    The inbox tool answers JSON — a list of messages with `from`, `subject`
    and `is_read`. It is read as JSON first and only parsed as prose if that
    fails, because a tool that changes its mind about which it speaks should
    cost this page a block, not fill it with fragments of the other one: a
    `"date":` line once reached the screen as a person's name.

    A machine is not waiting on you. Anything from a no-reply address is
    dropped, which is most of an inbox and all of its noise.
    """
    out_text = tool("email", {"action": "list_inbox", "limit": 25}, act)
    try:
        raw = json.loads(out_text)
    except Exception:  # noqa: BLE001
        raw = None
    out = []
    if isinstance(raw, list):
        for m in raw:
            if not isinstance(m, dict):
                continue
            who, addr = sender(m.get("from"))
            if NOREPLY.search(addr) or NOREPLY.search(who) or BULK_ADDR.search(addr):
                continue
            subj = str(m.get("subject") or "").strip()
            if not subj or BLAST.search(subj) or RECEIPT.search(subj):
                continue
            out.append({"id": f"m{m.get('id', len(out))}", "who": who[:40],
                        "subject": subj[:90], "unread": not m.get("is_read")})
            if len(out) >= 10:
                break
        # Unread first: those are the ones that are actually waiting.
        out.sort(key=lambda m: not m["unread"])
    return out


def weather(now, act):
    text = tool("get_forecast", {"days": 1}, act)
    nums = re.findall(r"(-?\d+)\s*°", text)
    first = text.strip().splitlines()[0] if text.strip() else ""
    cond = re.sub(r"[^A-Za-z ,]", " ", first)
    cond = re.sub(r"\s+", " ", cond).strip()[:40]
    if not nums:
        raise Gap("the forecast had no temperature in it")
    hi, lo = (max(int(n) for n in nums[:4]), min(int(n) for n in nums[:4]))
    return {"temp": f"{nums[0]}°", "range": f"{lo}° / {hi}°", "condition": cond or "Today",
            "symbol": symbol_for(cond), "tint": "blue"}


def symbol_for(cond):
    c = (cond or "").lower()
    for word, sym in (("thunder", "cloud.bolt"), ("snow", "cloud.snow"), ("rain", "cloud.rain"),
                      ("drizzle", "cloud.drizzle"), ("fog", "cloud.fog"), ("mist", "cloud.fog"),
                      ("overcast", "cloud"), ("cloud", "cloud.sun"), ("clear", "sun.max"),
                      ("sun", "sun.max")):
        if word in c:
            return sym
    return "cloud.sun"


def house(now, act):
    """Only what is NOT right. A list of every device is a different page.

    The tool answers a pretty-printed JSON array of
    {entity_id, state, available, friendly_name} — `available` is the field
    to trust, not `state`: false means the reading was "unavailable",
    "unknown" or empty, and rendering that as "off" would report a door as
    shut because nobody could see it.
    """
    rows_json = tool("home_assistant", {"action": "get_entities"}, act)
    try:
        ents = json.loads(rows_json)
    except Exception:  # noqa: BLE001
        raise Gap("it answered something that was not the list of entities") from None
    if not isinstance(ents, list):
        raise Gap("it answered something that was not the list of entities")

    out = []
    for e in ents:
        if not isinstance(e, dict) or not e.get("available"):
            continue
        eid = str(e.get("entity_id") or "")
        state = str(e.get("state") or "").lower()
        name = str(e.get("friendly_name") or eid.split(".")[-1].replace("_", " ")).strip()
        if eid.startswith("lock.") and state == "unlocked":
            out.append(("lock.open", "red", f"{name} is unlocked"))
        elif eid.startswith("cover.") and state == "open":
            out.append(("door.garage.open", "amber", f"{name} is open"))
        elif eid.startswith("binary_sensor.") and state == "on" \
                and re.search(r"door|window|gate", name, re.I):
            out.append(("door.left.hand.open", "amber", f"{name} is open"))
        if len(out) >= 5:
            break
    return [{"id": f"h{i}", "icon": ic, "tint": tn, "what": what, "detail": ""}
            for i, (ic, tn, what) in enumerate(out)]


# ---------------------------------------------------------------------------
# The briefing
#
# The one part of this page a model writes, and it is NEVER in the request
# path. A page you open eight times a day cannot wait on inference eight
# times, and a briefing that is six minutes stale is worth more than one that
# costs four seconds.
#
# So: the briefing is cached against a DIGEST of what it was written about.
# On every load the digest is recomputed; if it matches, the cache is served
# untouched and nothing is spent. If it differs, the STALE briefing is served
# at once — labelled with its age — and a regeneration runs in the
# background for the next load. The page is never blocked and never empty
# once it has been written once.
#
# The digest is over what the briefing is ABOUT, not over the clock: ids and
# their state. A minute passing is not news. A reminder being ticked is.
# ---------------------------------------------------------------------------

BRIEF_DIR = os.path.join(DATA, "brief")
_regen = set()
_regen_lock = threading.Lock()

# One question in flight per person, and the context their last page was
# drawn from. The context is on DISK rather than in a dict because the answer
# is written by a thread that may outlive the request, and because a restart
# between the press and the answer should cost a re-ask, not a crash.
ASK_DIR = os.path.join(DATA, "ask")
_asking = set()
_ask_lock = threading.Lock()

ASK_SYSTEM = """You answer one question about one person's day, inside their
own assistant. You are given everything their hub knows about today, then
their question.

- Answer the question that was asked. Two or three sentences unless they
  asked for a list, in which case give a short one.
- Use ONLY what is below. If the answer is not there, say which part of it
  you cannot see — "nothing in the calendar says where that is" — rather
  than guessing or apologising.
- Name real things: times, people, amounts. Never "you have several items".
- No preamble. Do not restate the question. Do not offer to help further.
- Markdown is allowed for a list or for emphasis, and is not wanted for
  anything else.

Each block below is a SEPARATE subject. Never join facts from two blocks
into one sentence.
"""

BRIEF_SYSTEM = """You write one person's daily briefing inside their own assistant.

You are given everything their hub knows about today. Answer ONLY with JSON:

{"headline": "...", "focus": {"what": "...", "why": "..."},
 "notes": [{"what": "...", "why": "..."}], "mood": "calm|busy|behind"}

- headline: ONE sentence on the state of the day. Concrete. Name real things.
  Not "you have a busy day" — "Three meetings before noon, then the afternoon
  is yours."
- focus: the single thing worth their attention today, and why it is that
  one rather than another. Prefer something with a deadline, someone waiting,
  or a consequence. If nothing deserves it, say so in `what` and leave `why`
  empty.
- notes: up to four things to KNOW or to be thinking about next — something
  coming, something that has gone quiet, something that will become a problem.
  Not a restatement of the lists; they can already see those.
- mood: `behind` if things are overdue or someone is waiting, `busy` if the
  day is full, `calm` otherwise.

Each block below is a SEPARATE subject. Never join facts from two blocks
into one sentence — a person's location and a failing job on the hub have
nothing to do with each other, and a briefing that implies they do is worse
than one that omits both.

Write like a sharp colleague who read everything before you got in. Short
sentences. No preamble, no "here is", no bullets inside a field. Never invent
a fact that is not below; if something is unknown, leave it out.
"""


def safe_user(user):
    """A user id that is safe as a filename. One place, three callers."""
    return "".join(c for c in (user or "nobody") if c.isalnum() or c in "-_") or "nobody"


def brief_path(user):
    os.makedirs(BRIEF_DIR, exist_ok=True)
    return os.path.join(BRIEF_DIR, f"{safe_user(user)}.json")


def ask_path(user, ext="json"):
    os.makedirs(ASK_DIR, exist_ok=True)
    return os.path.join(ASK_DIR, f"{safe_user(user)}.{ext}")


def digest_of(items, evs):
    """What the briefing is ABOUT, as one string.

    State, not time: a tick, an arrival or a departure changes it; a minute
    passing does not.
    """
    parts = [f"{i['kind']}:{i['id']}:{i.get('late', '')}" for i in items]
    parts += [f"e:{e['id']}:{e['at'].isoformat()}" for e in evs]
    parts.append(datetime.now().strftime("%Y-%m-%d"))  # a new day is new news
    return hashlib.sha1("|".join(sorted(parts)).encode()).hexdigest()[:16]


def context_for(items, evs, now, extras):
    """Everything the briefing is allowed to know, as plain lines."""
    out = []
    today = [e for e in evs if e["at"].date() == now.date()]
    if today:
        out.append("TODAY'S CALENDAR:")
        for e in today:
            mark = "(done)" if e["at"] + timedelta(minutes=e["mins"]) < now else ""
            out.append(f"- {clock(e['at'])} {e['title']}"
                       + (f" at {e['where']}" if e["where"] else "") + f" {mark}".rstrip())
    later = [e for e in evs if e["at"].date() > now.date()]
    if later:
        out.append("\nTOMORROW:")
        for e in later[:5]:
            out.append(f"- {clock(e['at'])} {e['title']}")
    by_kind = {}
    for i in items:
        by_kind.setdefault(i["kind"], []).append(i)
    for kind, label in (("task", "DUE OR OVERDUE"), ("mail", "UNANSWERED MAIL"),
                        ("note", "RAISED SINCE LAST NIGHT")):
        rowsk = by_kind.get(kind) or []
        if rowsk:
            out.append(f"\n{label}:")
            for i in rowsk[:12]:
                out.append(f"- {i['text']}" + (f" ({i['when']})" if i.get("when") else ""))
    for line in extras:
        out.append(f"\n{line}")
    out.append(f"\nIt is {now.strftime('%A %-d %B, %H:%M')}.")
    return "\n".join(out)


def write_brief(user, key, context):
    """Ask for the briefing and file it. Runs OFF the request path."""
    try:
        answer = ask_claude(BRIEF_SYSTEM, [{"role": "user", "content": context}],
                            work="periodic_check", max_tokens=600)
        text = answer.strip()
        if text.startswith("```"):
            text = text.split("```")[1].lstrip("json").strip()
        data = json.loads(text[text.index("{"):text.rindex("}") + 1])
        if not isinstance(data.get("headline"), str):
            raise ValueError("no headline")
        data["at"] = datetime.now().isoformat(timespec="minutes")
        with _regen_lock:
            json.dump({"digest": key, "brief": data}, open(brief_path(user), "w"))
    except Exception as e:  # noqa: BLE001 — a briefing that fails costs a block
        print(f"today: briefing failed: {type(e).__name__}: {e}", flush=True)
    finally:
        with _regen_lock:
            _regen.discard((user, key))


def write_answer(user, question, context):
    """Answer one question and file it. Runs OFF the request path.

    Same shape as `write_brief`, and for the same reason: a model call is
    seconds and a descriptor action is something a finger is waiting on. The
    press files the question, this writes the answer, and `nudge()` tells the
    open page to refetch — which is the machinery the briefing already uses,
    so there is one way this page gets late news instead of two.
    """
    rec = {"question": question, "at": datetime.now().isoformat(timespec="minutes")}
    try:
        rec["text"] = ask_claude(
            ASK_SYSTEM,
            [{"role": "user", "content": f"{context}\n\nTHEIR QUESTION: {question}"}],
            work="periodic_check", max_tokens=500).strip()
        if not rec["text"]:
            raise ValueError("the model answered with nothing")
    except Gap as e:
        rec["failed"] = str(e)
    except Exception as e:  # noqa: BLE001 — a question that fails costs a line
        rec["failed"] = f"{type(e).__name__}"
        print(f"today: answer failed: {type(e).__name__}: {e}", flush=True)
    try:
        json.dump(rec, open(ask_path(user), "w"))
    except Exception as e:  # noqa: BLE001
        print(f"today: could not file the answer: {type(e).__name__}", flush=True)
    with _ask_lock:
        _asking.discard(user)
    nudge()


def answer_for(user, now):
    """What is on the page: a question in flight, an answer, or neither."""
    with _ask_lock:
        in_flight = user in _asking
    try:
        rec = json.load(open(ask_path(user)))
    except Exception:  # noqa: BLE001 — nothing asked yet
        rec = None
    if in_flight:
        return None, (rec or {}).get("question", "")
    if not rec:
        return None, ""
    written = when(rec.get("at"))
    mins = int((now - written).total_seconds() // 60) if written else 0
    return {"question": rec.get("question", ""),
            "text": rec.get("text", ""),
            "failed": rec.get("failed", ""),
            "age": ("just now" if mins < 2 else f"{mins} min ago" if mins < 90
                    else f"{mins // 60}h ago" if mins < 24 * 60 else "earlier")}, ""


def ui_action(name, args, user):
    """The hub's action channel — `POST /leo/ui/action`.

    Three verbs, and every one of them returns at once: `ask` files the
    question and hands the model call to a thread, `clear` forgets the last
    answer, `rewrite` drops the cached briefing so the next draw rebuilds it.
    Nothing here blocks on a model.
    """
    if name == "ask":
        question = str(args.get("text") or "").strip()[:300]
        if not question:
            return {"ok": False, "error": "no question"}
        try:
            context = open(ask_path(user, "ctx")).read()
        except Exception:  # noqa: BLE001 — never drawn for this person yet
            context = ""
        if not context:
            return {"ok": False, "error": "nothing to answer from yet"}
        with _ask_lock:
            if user in _asking:
                return {"ok": True, "busy": True}
            _asking.add(user)
        json.dump({"question": question, "at": datetime.now().isoformat(timespec="minutes")},
                  open(ask_path(user), "w"))
        threading.Thread(target=write_answer, daemon=True,
                         args=(user, question, context)).start()
        return {"ok": True}
    if name == "clear":
        try:
            os.remove(ask_path(user))
        except OSError:
            pass
        return {"ok": True}
    if name == "rewrite":
        try:
            os.remove(brief_path(user))
        except OSError:
            pass
        return {"ok": True}
    return {"ok": False, "error": f"no such action: {name}"}


def briefing(user, items, evs, now, extras, context=None):
    """The cached briefing, and a regeneration if it is out of date."""
    key = digest_of(items, evs)
    try:
        held = json.load(open(brief_path(user)))
    except Exception:  # noqa: BLE001
        held = None

    if not held or held.get("digest") != key:
        with _regen_lock:
            if (user, key) not in _regen:
                _regen.add((user, key))
                threading.Thread(target=write_brief, daemon=True,
                                 args=(user, key,
                                       context if context is not None
                                       else context_for(items, evs, now, extras))).start()

    if not held:
        return None
    d = dict(held["brief"])
    stale = held.get("digest") != key
    written = when(d.pop("at", None))
    if written:
        mins = int((now - written).total_seconds() // 60)
        d["age"] = ("just now" if mins < 2 else
                    f"{mins} min ago" if mins < 90 else
                    f"{mins // 60}h ago" if mins < 24 * 60 else written.strftime("%a"))
    d["stale"] = "1" if stale else ""
    return d


def money(now, act):
    """Month to date, against what a month usually costs.

    `spending_summary` answers DOLLARS (the tool divides cents by 100), while
    the transactions route answers signed CENTS. Mixing those is a factor of
    a hundred on a page about money, so only one of them is read here.
    """
    first = now.replace(day=1).date().isoformat()
    out = tool("finance", {"action": "spending_summary",
                           "start_date": first, "end_date": now.date().isoformat()}, act)
    d = json.loads(out)
    total = float(d.get("total_spending") or 0)
    if total <= 0:
        raise Gap("no spending is recorded for this month yet")
    cats = sorted((d.get("categories") or []), key=lambda c: -float(c.get("total") or 0))
    top = cats[0] if cats else None
    return {"amount": f"${total:,.0f}",
            "note": f"{top['category_name']} is the largest at ${float(top['total']):,.0f}"
                    if top and top.get("category_name") else "this month so far",
            "tint": "blue", "used": "0", "rest": "1"}


def spend(now, _act):
    """What the household's own models cost. Bare package credential."""
    d = (graph("costs/live") or {}).get("data") or {}
    so_far = float(d.get("spent_usd") or 0)
    projected = float(d.get("projected_usd") or 0)
    rate = float(d.get("daily_run_rate_usd") or 0)
    if so_far <= 0:
        raise Gap("nothing is recorded for this period")
    used = max(0.0, min(1.0, so_far / projected)) if projected > 0 else 1.0
    return {"amount": f"${so_far:,.2f}",
            "note": f"${rate:,.2f} a day — on track for ${projected:,.0f} by month end"
                    if projected else "this month",
            "tint": "red" if used >= 0.9 else ("amber" if used >= 0.75 else "blue"),
            "scale": "this month so far" if projected else "recorded this period",
            "cap": f"of ${projected:,.0f} projected" if projected else "",
            "used": str(int(used * 100)), "rest": str(100 - int(used * 100))}


def box(now, _act):
    """Only what is WRONG with the box. Bare package credential both times."""
    out = []
    try:
        jobs = (graph("scheduler/jobs") or {}).get("data") or []
        bad = [j for j in jobs if j.get("enabled") and str(j.get("last_status") or "") not in
               ("", "success", "running")]
        for j in bad[:3]:
            last = when(j.get("last_run_at"))
            out.append({"icon": "clock.badge.exclamationmark", "tint": "amber",
                        "what": f"{j.get('name') or j.get('id')} is failing",
                        "detail": f"last ran {clock(last)} {last.strftime('%-d %b')}" if last else ""})
    except Gap:
        pass
    try:
        rel = (graph("releases/pending") or {}).get("releases") or []
        if rel:
            out.append({"icon": "shippingbox", "tint": "teal",
                        "what": f"{len(rel)} build{'s' if len(rel) > 1 else ''} landed, unannounced",
                        "detail": str(rel[0].get("version") or "")})
    except Gap:
        pass
    if not out:
        raise Gap("nothing is wrong with the box")
    return [{"id": f"b{i}", **row} for i, row in enumerate(out)]


def whereis(now, _act):
    """Who is where. Bare package credential; `address` arrives resolved."""
    rows_ = (graph("locations/latest") or {}).get("data") or []
    try:
        who = {p.get("id") or p.get("user_id"): (p.get("name") or p.get("display_name"))
               for p in ((graph("people") or {}).get("data") or [])}
    except Gap:
        who = {}
    out = []
    for r in rows_:
        seen = when(r.get("recorded_at"))
        if not seen or (now - seen) > timedelta(hours=6):
            continue
        name = who.get(r.get("user_id")) or str(r.get("user_id") or "")[:8]
        place = str(r.get("address") or "").split(",")[0][:40]
        if not place:
            continue
        mins = int((now - seen).total_seconds() // 60)
        out.append({"id": f"w{len(out)}", "icon": "location", "tint": "green",
                    "what": f"{name} — {place}",
                    "detail": "just now" if mins < 5 else f"{mins} min ago" if mins < 90
                              else f"{mins // 60}h ago"})
    if not out:
        raise Gap("nobody has shared a location recently")
    return out[:4]


