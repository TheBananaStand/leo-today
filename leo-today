# LEO_PACKAGE_TOKEN scoped to inference and NOTHING ELSE — `graph_scopes_for`
# builds its list from the inference entitlement alone — so the settings
# token, which is the one minted with the read scopes, has to win.
TOKEN = (os.environ.get("today_graph_token")
         or os.environ.get("TODAY_GRAPH_TOKEN")
         or os.environ.get("LEO_PACKAGE_TOKEN") or "")
PORT = int(os.environ.get("PORT") or os.environ.get("LEO_APP_PORT") or "8477")
DATA = os.environ.get("LEO_DATA_DIR", ".")

TIMEOUT = 3.0
SHOWN = 6
# The window the day strip is drawn across. Widened by anything outside it.
DAY_FROM, DAY_TO = 7 * 60, 19 * 60

TINTS = ["blue", "purple", "teal", "orange", "green", "pink", "amber"]


def plural(n, one, many=None):
    """`1 subjects, 4 items` was on this page beside a line four lines away in
    this file that got it right. One helper, so there is one place to get it
    wrong."""
    return f"{n} {one if n == 1 else (many or one + 's')}"


def mark_last(rows):
    """Flag the final row, so the markup can leave its divider off.

    A `border-b` on every row of a grouped list draws a hairline flush
    against the card's own rounded bottom edge — visible in every render of
    this page since it had lists. The subset has no `:last-child`, so the
    producer is where the fact lives.
    """
    for i, r in enumerate(rows):
        r["last"] = "1" if i == len(rows) - 1 else ""
    return rows


def hue(name):
    """A stable colour for a name.

    `hash()` of a str is salted per PROCESS in Python, so a calendar that was
    purple before a restart came back amber after one — and a colour that
    changes is not an identity, it is decoration. crc32 is the same number on
    every box, every run, forever.
    """
    return TINTS[zlib.crc32((name or "").encode()) % len(TINTS)]
_lock = threading.Lock()


class Gap(Exception):
    """A source did not answer. Carries a sentence a person can read."""


def scope_reason(e):
    """The 403 said WHY in a JSON envelope. Say that, not the envelope.

    The footer draws one line of 12pt muted text per gap. A raw body there is
    a wall — measured on this box, where two of six gap lines were the hub's
    `{"error":{"code":"forbidden_scope","message":...}}` cut off mid-sentence
    at 160 characters. The message inside it is already a sentence; the
    envelope around it is the only part that was unreadable.
    """
    try:
        body = json.loads((e.read() or b"").decode())
    except Exception:  # noqa: BLE001 — not JSON, or already consumed
        return "a scope is missing"
    msg = ((body.get("error") or {}).get("message")
           or body.get("message") or body.get("error") or "")
    msg = str(msg).split(" — ", 1)[0].split(". ", 1)[0].strip().rstrip(".")
    return (msg[:90] + "…") if len(msg) > 90 else (msg or "a scope is missing")


# ---------------------------------------------------------------------------
# Reaching the hub
# ---------------------------------------------------------------------------

def _call(path, token, data=None, **params):
    url = f"{API}{path}"
    if params:
        url += "?" + urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(
        url, data=body, method="POST" if body else "GET",
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        return json.loads(r.read().decode())


def graph(path, token=None, **params):
    """One Graph GET, with a readable failure.

    `token` is the ACTING credential when there is one. Several domains —
    reminders, the feed — answer for ONE person and refuse a bare package
    credential outright, so those reads must carry a token exchanged from the
    grant the hub stamps on the request.
    """
    token = token or TOKEN
    if not token:
        raise Gap("this package has no Graph credential — see the README")
    try:
        return _call(f"/graph/v1/{path}", token, **params)
    except urllib.error.HTTPError as e:
        if e.code == 403:
            raise Gap(f"the hub refused it (403) — {scope_reason(e)}") from None
        if e.code == 501:
            raise Gap("this hub does not serve that route") from None
        raise Gap(f"the hub answered {e.code}") from None
    except TimeoutError:
        raise Gap(f"it timed out after {TIMEOUT:g}s") from None
    except Exception as e:  # noqa: BLE001 — a source never takes the page down
        raise Gap(f"{type(e).__name__}: {e}") from None


def tool(name, args, token):
    """Run one hub tool as the acting person.

    The blocks that have no Graph domain of their own — the weather, the mail,
    the house — are tools, and `/graph/v1/tools/invoke` runs one through the
    hub's whole gate chain as whoever the acting token names. `destination`
    is `hub`: the answer is going onto a page, not into a model.
    """
    if not token:
        raise Gap("no acting credential — this block is per-person")
    try:
        out = _call("/graph/v1/tools/invoke", token,
                    data={"name": name, "arguments": args, "destination": "hub"})
    except urllib.error.HTTPError as e:
        raise Gap(f"the hub refused `{name}` ({e.code})") from None
    except Exception as e:  # noqa: BLE001
        raise Gap(f"`{name}`: {type(e).__name__}") from None
    if out.get("is_error"):
        body = str(out.get("output") or "")
        # The tool's own prose is the discriminator, and it is worth keeping:
        # a house that is switched off is not a page that is broken.
        if "error sending request" in body:
            raise Gap("Home Assistant isn't answering — the box it runs on looks to be off")
        if "error decoding response body" in body:
            raise Gap("Home Assistant refused the credential — its token may have expired")
        if body.startswith("Home Assistant error"):
            raise Gap("Home Assistant answered with an error")
        raise Gap(f"`{name}` answered with an error")
    return out.get("output") or ""


def ask_claude(system, turns, work="periodic_check", max_tokens=600):
    """One model call, through the hub — this package never holds a key.

    `work` says what KIND of work it is instead of naming a model, so the
    household's own routing picks one and its ceiling can downgrade it.

    The retry is not an optimisation. The built-in model catalog prices
    exactly ONE model, so on a hub whose `model_catalog` has never been
    edited the household default is refused outright — "declares no rate, so
    a call would be billed at $0". `periodic_check` is the class that routes
    to the `fast` role, which IS the priced one. Still never naming a model:
    the hub picks both times.
    """
    def send(w):
        body = json.dumps({"work": w, "max_tokens": max_tokens,
                           "system": system, "messages": turns}).encode()
        req = urllib.request.Request(
            f"{API}/graph/v1/inference/messages", data=body, method="POST",
            headers={"Authorization": f"Bearer {TOKEN}", "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=90) as r:
            return json.loads(r.read().decode())

    try:
        answer = send(work)
    except urllib.error.HTTPError as e:
        detail = (e.read() or b"").decode()
        if e.code != 503 or "declares no rate" not in detail:
            raise Gap(f"the hub refused the model call ({e.code})") from None
        answer = send("periodic_check")
    out = [b.get("text", "") for b in (answer.get("content") or [])
           if isinstance(b, dict) and b.get("type") == "text"]
    return "".join(out).strip()


def nudge():
    """Tell any open Today page to refetch.

    The briefing is written on a background thread, so by the time it exists
    the page that triggered it has already been drawn. Without this it would
    appear on the NEXT load, which on a page you leave open all day could be
    hours. `surfaces/changed` is the hub's own refresh channel — the same one
    a POST to `/api/reminders/...` rings by path — and the hub coalesces
    repeats within a second, so a burst of rewrites is one refetch.
    """
    try:
        _call("/graph/v1/surfaces/changed", TOKEN, data={"topic": "today"})
    except Exception as e:  # noqa: BLE001 — a nudge that fails costs a refresh
        print(f"today: could not nudge the surface: {type(e).__name__}", flush=True)


def acting(grant):
    """Spend the hub's single-use grant for a token that acts for the asker.

    No grant, or an exchange that fails, is not fatal: the household domains
    still answer on the package credential, and the per-person blocks report
    themselves missing like any other source.
    """
    if not grant or not TOKEN:
        return None
    try:
        return _call("/graph/v1/acting/exchange", TOKEN, data={"grant": grant}).get("access_token")
    except Exception:  # noqa: BLE001
        return None


def rows(v, *keys):
    """The list inside a Graph answer, whatever it wrapped it in."""
    if isinstance(v, list):
        return v
    if isinstance(v, dict):
        for k in keys:
            if isinstance(v.get(k), list):
                return v[k]
        for val in v.values():
            if isinstance(val, list):
                return val
    return []


# ---------------------------------------------------------------------------
# Time
# ---------------------------------------------------------------------------

def when(ts):
    try:
        return datetime.fromisoformat(str(ts).replace("Z", "+00:00")).astimezone()
    except Exception:  # noqa: BLE001
        return None


def clock(t):
    return t.strftime("%H:%M") if t else ""


def minutes(t):
    return t.hour * 60 + t.minute


def human_len(mins):
    """A length a person says out loud. `180m` is a number, `3h` is a length."""
    if not mins:
        return ""
    h, m = divmod(int(mins), 60)
    if not h:
        return f"{m}m"
    return f"{h}h" if not m else f"{h}h {m:02d}m"


def lead(start, now):
    mins = int((start - now).total_seconds() // 60)
    if mins < -1:
        return "Started"
    if mins <= 1:
        return "Now"
    if mins < 60:
        return f"In {mins} minutes"
    if mins < 300:
        h, m = divmod(mins, 60)
        return f"In {h}h {m:02d}m" if m else f"In {h} hours"
    if start.date() != now.date():
        return start.strftime("Tomorrow %H:%M") if start.date() == (now + timedelta(days=1)).date() \
            else start.strftime("%A %H:%M")
    return start.strftime("At %H:%M")


def short_when(t, now):
    """How far off, in the fewest characters that stay true.

    `lead` is for the hero, where "In 25 minutes" is the point. A thread's
    chip has room for two or three characters, and past about half a day the
    hour stops meaning anything — a flight at 8:05 tomorrow is "tomorrow",
    not "At 8:05", which reads as this morning and is the one wrong answer
    the chip can give.
    """
    mins = int((t - now).total_seconds() // 60)
    if mins < 0:
        return "late"
    if mins < 60:
        return f"{mins}m"
    if mins < 12 * 60:
        return f"{mins // 60}h"
    if t.date() == now.date():
        return t.strftime("%H:%M")
    if t.date() == (now + timedelta(days=1)).date():
        return "tomorrow"
    return t.strftime("%a")


def due_words(d, today):
    late = (today - d).days
    if late > 45:
        months = max(1, round(late / 30))
        return f"{months} month{'s' if months > 1 else ''}", False
    if late > 1:
        return f"{late} days late", True
    if late == 1:
        return "Yesterday", True
    if late == 0:
        return "Today", False
    if late == -1:
        return "Tomorrow", False
    return d.strftime("%-d %b"), False


