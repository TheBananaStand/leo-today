#!/usr/bin/env python3
"""Today — the payload behind the Today screen.

A Leo "app" package: its own process, reached by the hub at
`GET /leo/ui/data`, which is what the Today screen's `{path}`s bind to.

It holds no model and no schedule. Everything it does is fetch a handful of
hub domains over the Graph and shape them into the ONE payload the markup
reads. The markup decides nothing about what is on the page: a block whose
list is empty is absent, because an empty array is falsy in the language.

The rule the error handling follows, and the reason this is worth reading:
EVERY SOURCE FAILS ON ITS OWN. A source that errors, times out, or that this
package's token may not reach leaves its key missing — so its block is simply
not on the page, the other blocks are unaffected, and the footer says which
one did not answer. A page that is down whenever any one package is down is
not a page you would keep open.
"""

import base64
import hashlib
import json
import os
import struct
import sys
import threading
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
import time
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

API = os.environ.get("LEO_API_URL", "http://127.0.0.1:8420").rstrip("/")
# The hub hands `LEO_PACKAGE_TOKEN` to an app whose entitlements earn one.
# Today's do not: `graph_scopes_for` (leo-package/src/manager.rs) only ever
# mints the INFERENCE scope, so a declared `graph_scopes` is stored,
# validated and never turned into a credential. Until that is fixed the
# token arrives the other supported way — a settings key this package
# declares in `settings_read`, which the hub hands over as an env var.
# ORDER MATTERS. Declaring `entitlements.inference` makes the hub mint a
# LEO_PACKAGE_TOKEN — scoped to inference and NOTHING ELSE, because
# `graph_scopes_for` builds its list from the inference entitlement alone. The
# settings token is the one minted with the read scopes, so it has to win;
# preferring the hub's would silently cost the page its calendar.
TOKEN = (os.environ.get("today_graph_token")
         or os.environ.get("TODAY_GRAPH_TOKEN")
         or os.environ.get("LEO_PACKAGE_TOKEN") or "")
PORT = int(os.environ.get("PORT") or os.environ.get("LEO_APP_PORT") or "8477")

# A source gets this long and no longer. The page is a glance: four sources
# answering in parallel means the slowest one is the wait, so the budget is
# per-source and small rather than one clock around the lot.
TIMEOUT = 2.5
# What a glance shows. The cap is HERE and not in the markup: 40 rows laid
# out is 2691pt of scroll, which is a list, not a glance. The count beside
# the heading is what says there are more.
SHOWN = 5

TINTS = ["blue", "purple", "teal", "orange", "green", "pink", "amber", "red"]


def ask_claude(system, turns, work="conversation"):
    """One turn, through the hub — this package never holds a model key.

    `work` says what KIND of work this is instead of naming a model, so the
    household's own routing picks one and the ceiling can downgrade it. A
    hardcoded model id here would be a second opinion about a decision the hub
    already owns.
    """
    body = json.dumps({
        "work": work,
        "max_tokens": 700,
        "system": system,
        "messages": turns,
    }).encode()
    req = urllib.request.Request(
        f"{API}/graph/v1/inference/messages", data=body, method="POST",
        headers={"Authorization": f"Bearer {TOKEN}", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=90) as r:
        answer = json.loads(r.read().decode())
    out = []
    for block in answer.get("content") or []:
        if isinstance(block, dict) and block.get("type") == "text":
            out.append(block.get("text", ""))
    return "".join(out).strip() or "(no answer)"


class Gap(Exception):
    """A source did not answer. Carries what to tell the reader."""


def graph(path, token=None, **params):
    """One Graph GET. Raises Gap with a sentence a person can read.

    `token` is the ACTING credential when there is one. Several hub domains —
    reminders, the feed — answer for one person and refuse a bare package
    credential outright: "this endpoint answers for one person and a package
    credential names none". Those reads must carry a token exchanged from the
    grant the hub stamps on the request.
    """
    token = token or TOKEN
    if not token:
        raise Gap("this package has no Graph credential — see the README")
    url = f"{API}/graph/v1/{path}"
    if params:
        url += "?" + urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        body = e.read().decode()[:200]
        if e.code == 403:
            raise Gap(f"the hub refused it (403) — a scope is missing: {body}") from None
        if e.code == 501:
            raise Gap("this hub does not serve that route") from None
        raise Gap(f"the hub answered {e.code}") from None
    except TimeoutError:
        raise Gap(f"it timed out after {TIMEOUT:g}s") from None
    except Exception as e:  # noqa: BLE001 — a source never takes the page down
        raise Gap(f"{type(e).__name__}: {e}") from None


def acting(grant):
    """Spend the hub's single-use grant for a token that acts for the asker.

    No grant, or an exchange that fails, is not fatal: the household domains
    still answer on the package credential, so the page keeps the blocks it
    can have and the per-person ones report themselves missing like any other
    source.
    """
    if not grant or not TOKEN:
        return None
    body = json.dumps({"grant": grant}).encode()
    req = urllib.request.Request(
        f"{API}/graph/v1/acting/exchange", data=body, method="POST",
        headers={"Authorization": f"Bearer {TOKEN}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            return json.loads(r.read().decode()).get("access_token")
    except Exception:  # noqa: BLE001
        return None


def rows(v, *keys):
    """The list inside a Graph answer, whatever it wrapped it in."""
    if isinstance(v, list):
        return v
    if isinstance(v, dict):
        for k in keys:
            if isinstance(v.get(k), list):
                return v[k]
        for val in v.values():
            if isinstance(val, list):
                return val
    return []


def clock(ts):
    """`2026-11-24T09:30:00Z` -> `9:30`, in this box's own timezone."""
    try:
        t = datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
        return t.astimezone().strftime("%-I:%M")
    except Exception:  # noqa: BLE001
        return ""


def when(ts):
    try:
        return datetime.fromisoformat(str(ts).replace("Z", "+00:00")).astimezone()
    except Exception:  # noqa: BLE001
        return None


def lead(start, now):
    """How far off a thing is, as a person would say it."""
    mins = int((start - now).total_seconds() // 60)
    if mins < -1:
        return "Started"
    if mins <= 1:
        return "Now"
    if mins < 60:
        return f"In {mins} minutes"
    if mins < 180:
        h, m = divmod(mins, 60)
        return f"In {h}h {m:02d}m" if m else f"In {h} hours"
    return start.strftime("At %-I:%M")


def events(now, _act):
    start = now.replace(hour=0, minute=0, second=0, microsecond=0)
    raw = rows(graph("calendar/events",
                     start=start.isoformat(),
                     end=(start + timedelta(days=1)).isoformat()), "events", "items")
    out = []
    for e in raw:
        t = when(e.get("start") or e.get("start_at") or e.get("starts_at"))
        if not t or t < now - timedelta(hours=2):
            continue
        cal = str(e.get("calendar") or e.get("calendar_name") or "")
        out.append({
            "id": str(e.get("id") or len(out)),
            "at": t,
            "time": clock(e.get("start") or e.get("start_at") or e.get("starts_at")),
            "title": str(e.get("title") or e.get("summary") or "Untitled"),
            "where": str(e.get("location") or "")[:60],
            "calendar": cal,
            "tint": TINTS[hash(cal) % len(TINTS)] if cal else "blue",
            "now": "1" if t <= now <= t + timedelta(minutes=int(e.get("duration_min") or 60)) else "",
        })
    out.sort(key=lambda r: r["at"])
    return out


def tasks(now, act):
    raw = rows(graph("reminders/items", token=act, active_only="true"), "items", "reminders")
    today = now.date()
    out = []
    for r in raw:
        if r.get("completed") or r.get("done"):
            continue
        due = when(r.get("due") or r.get("due_at") or r.get("due_date"))
        if not due:
            continue
        d = due.date()
        if d > today:
            continue  # today and overdue only — this is Today, not everything
        late = (today - d).days
        out.append({
            "id": str(r.get("id") or len(out)),
            "late": late,
            "title": str(r.get("title") or "Untitled"),
            "due": "Today" if late == 0 else ("Yesterday" if late == 1 else f"{late} days late"),
            "overdue": "1" if late > 0 else "",
            "done": "",
        })
    out.sort(key=lambda r: -r["late"])
    return out


ICONS = {"alert": ("exclamationmark.triangle", "amber"),
         "recommendation": ("lightbulb", "teal"),
         "action_taken": ("checkmark.circle", "green"),
         "briefing": ("doc.text", "blue")}


def notes(now, act):
    raw = rows(graph("feed/items", token=act, limit="20"), "items", "feed")
    out = []
    for n in raw:
        if n.get("dismissed") or n.get("deleted_at"):
            continue
        t = when(n.get("created_at") or n.get("created"))
        if t and (now - t) > timedelta(hours=18):
            continue
        icon, tint = ICONS.get(str(n.get("feed_type") or ""), ("sparkles", "purple"))
        out.append({
            "id": str(n.get("id") or len(out)),
            "icon": icon, "tint": tint,
            "title": str(n.get("title") or "Untitled"),
            "body": str(n.get("chat_summary") or n.get("body") or "")[:240],
            "when": clock(n.get("created_at") or n.get("created")),
        })
    return out


def payload(grant=None):
    now = datetime.now(timezone.utc).astimezone()
    act = acting(grant)
    sources = {"events": events, "tasks": tasks, "notes": notes}
    got, gaps = {}, []

    # In parallel, and each one's failure is its own. Nothing here can make
    # another source's block disappear.
    with ThreadPoolExecutor(max_workers=len(sources)) as pool:
        futures = {k: pool.submit(fn, now, act) for k, fn in sources.items()}
        for key, fut in futures.items():
            try:
                got[key] = fut.result()
            except Gap as g:
                gaps.append({"id": key, "what": f"{key.title()} didn't answer — {g}."})
            except Exception as e:  # noqa: BLE001
                gaps.append({"id": key, "what": f"{key.title()} didn't answer — {type(e).__name__}."})

    ev, ta, no = got.get("events", []), got.get("tasks", []), got.get("notes", [])
    d = {"loaded": "1"}

    if len(gaps) == len(sources):
        # Nothing answered: one real state with a way out, and no footer
        # repeating what the card already says.
        d["nothing_worked"] = "1"
        # Every source failing for the SAME reason is one fault, not three.
        reasons = list(dict.fromkeys(g["what"].split(" didn't answer — ", 1)[-1] for g in gaps))
        d["why"] = ("Nothing answered: " + reasons[0]) if len(reasons) == 1 \
            else " ".join(g["what"] for g in gaps)
        return d

    if ev:
        nxt = next((e for e in ev if e["at"] >= now), ev[0])
        d["next"] = {"lead": lead(nxt["at"], now), "time": nxt["time"],
                     "title": nxt["title"], "where": nxt["where"],
                     "icon": "calendar", "tint": nxt["tint"]}
        d["events"] = [{k: v for k, v in e.items() if k != "at"} for e in ev[:SHOWN]]
        d["events_note"] = f"{len(ev)} today" if len(ev) <= SHOWN else f"{SHOWN} of {len(ev)}"
    if ta:
        d["tasks"] = ta[:SHOWN]
        over = sum(1 for t in ta if t["overdue"])
        d["tasks_note"] = (f"{over} late" if over else f"{len(ta)} due") if len(ta) <= SHOWN \
            else f"{SHOWN} of {len(ta)}"
    if no:
        d["notes"] = no[:SHOWN]

    if not ev and not ta and not no:
        if gaps:
            d["day_line"] = "Partly known"
            d["day_detail"] = f"{len(sources) - len(gaps)} of {len(sources)} sources answered, and they had nothing."
        else:
            d["all_clear"] = "1"
    elif not ev:
        d["day_line"] = "Nothing scheduled"
        d["day_detail"] = "No events on the calendar today."
    if gaps:
        d["gaps"] = gaps
    return d


# ---------------------------------------------------------------------------
# The thread
#
# `<conversation src=… history=…>` in the markup is the hub's own chat engine
# pointed at this process: `src` is a WebSocket the app proxy bridges to
# `/chat` here, `history` an ordinary GET. The element draws nothing — the
# page's markup draws each turn — so all this has to do is speak the two
# frames that matter: a `message` in, a `result` out.
#
# The proxy stamps the asker's identity and a single-use acting grant on the
# UPGRADE, exactly as it does on a UI-data request, so a thread can be told
# whose day it is about.
# ---------------------------------------------------------------------------

GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
THREADS = os.path.join(os.environ.get("LEO_DATA_DIR", "."), "threads")
_lock = threading.Lock()


def thread_path(user):
    os.makedirs(THREADS, exist_ok=True)
    safe = "".join(c for c in (user or "nobody") if c.isalnum() or c in "-_") or "nobody"
    return os.path.join(THREADS, f"{safe}.json")


def transcript(user):
    try:
        with open(thread_path(user)) as f:
            return json.load(f)
    except Exception:  # noqa: BLE001
        return []


def remember(user, role, text):
    with _lock:
        rows = transcript(user)
        rows.append({"id": f"{role}-{int(time.time() * 1000)}-{len(rows)}",
                     "role": role, "content": text,
                     "created_at": datetime.now(timezone.utc).isoformat()})
        # A glance page's thread is not an archive.
        rows = rows[-40:]
        with open(thread_path(user), "w") as f:
            json.dump(rows, f)
        return rows


def ws_frame(text):
    """One unmasked text frame, server to client."""
    data = text.encode()
    head = bytes([0x81])
    n = len(data)
    if n < 126:
        head += bytes([n])
    elif n < (1 << 16):
        head += bytes([126]) + struct.pack(">H", n)
    else:
        head += bytes([127]) + struct.pack(">Q", n)
    return head + data


def ws_read(sock):
    """One frame from the client, or None when it has gone."""
    def exact(n):
        buf = b""
        while len(buf) < n:
            chunk = sock.recv(n - len(buf))
            if not chunk:
                return None
            buf += chunk
        return buf

    head = exact(2)
    if not head:
        return None
    opcode = head[0] & 0x0F
    masked = head[1] & 0x80
    n = head[1] & 0x7F
    if n == 126:
        n = struct.unpack(">H", exact(2))[0]
    elif n == 127:
        n = struct.unpack(">Q", exact(8))[0]
    key = exact(4) if masked else b"\x00\x00\x00\x00"
    body = exact(n) or b""
    if masked:
        body = bytes(b ^ key[i % 4] for i, b in enumerate(body))
    if opcode == 0x8:  # close
        return None
    if opcode in (0x9, 0xA):  # ping / pong — nothing to answer with text
        return b""
    return body


def day_brief(grant):
    """What the page is showing, as words the model can answer about."""
    try:
        d = payload(grant)
    except Exception as e:  # noqa: BLE001
        return f"(today's data could not be read: {type(e).__name__})"
    parts = []
    for e in d.get("events", []):
        parts.append(f"- {e['time']} {e['title']}" + (f" ({e['where']})" if e.get("where") else ""))
    if parts:
        parts.insert(0, "On the calendar today:")
    due = [f"- {t['title']} ({t['due']})" for t in d.get("tasks", [])]
    if due:
        parts += ["", "Due or overdue:"] + due
    notes = [f"- {n['title']}: {n.get('body', '')}" for n in d.get("notes", [])]
    if notes:
        parts += ["", "Raised since last night:"] + notes
    for g in d.get("gaps", []):
        parts.append(f"(not available: {g['what']})")
    return "\n".join(parts) or "Nothing on the calendar, nothing due, nothing new."


SYSTEM = """You are Leo, answering about the person's day on their Today screen.

The page they are looking at is below. Answer from it. Be brief — one or two
sentences unless they ask for more, and no preamble. If something they ask
about is not on the page, say so plainly rather than guessing; a line saying a
source was unavailable means you do not know, not that there is nothing.

{brief}
"""


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def do_GET(self):  # noqa: N802
        path = self.path.split("?")[0]
        if path == "/chat" and "websocket" in (self.headers.get("Upgrade") or "").lower():
            self.talk()
            return
        if path == "/leo/ui/data":
            grant = self.headers.get("x-leo-acting-grant")
            body = json.dumps(payload(grant)).encode()
        elif path == "/chat/messages":
            # What `history=` reads: the turns, oldest first, as the chat
            # engine decodes them (`id`, `role`, `content`, `created_at`).
            body = json.dumps(transcript(self.headers.get("x-leo-user-id"))).encode()
        elif path in ("/leo/health", "/health"):
            body = b'{"ok":true}'
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def talk(self):
        """The thread's socket: a `message` in, a `result` out.

        One turn at a time, in this connection's own thread — the server is a
        ThreadingHTTPServer, so a long answer blocks nobody else. The grant is
        read ONCE, at the handshake, because it is single-use; the day it buys
        is the day this thread is about.
        """
        key = self.headers.get("Sec-WebSocket-Key")
        if not key:
            self.send_error(400)
            return
        accept = base64.b64encode(hashlib.sha1((key + GUID).encode()).digest()).decode()  # noqa: S324
        self.wfile.write(("HTTP/1.1 101 Switching Protocols\r\n"
                          "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                          f"Sec-WebSocket-Accept: {accept}\r\n\r\n").encode())
        self.wfile.flush()

        user = self.headers.get("x-leo-user-id") or ""
        brief = day_brief(self.headers.get("x-leo-acting-grant"))
        sock = self.connection
        while True:
            try:
                raw = ws_read(sock)
            except Exception:  # noqa: BLE001
                return
            if raw is None:
                return
            if not raw:
                continue
            try:
                frame = json.loads(raw.decode())
            except Exception:  # noqa: BLE001
                continue
            if frame.get("type") != "message":
                continue
            said = (frame.get("content") or "").strip()
            if not said:
                continue
            rows = remember(user, "user", said)
            turns = [{"role": "assistant" if r["role"] == "assistant" else "user",
                      "content": r["content"]} for r in rows[-12:]]
            system = SYSTEM.format(brief=brief)
            try:
                try:
                    answer = ask_claude(system, turns)
                except urllib.error.HTTPError as e:
                    # The seed model catalog prices exactly ONE model, so on a
                    # hub whose `model_catalog` has never been edited the
                    # household's default is refused: "declares no rate, so a
                    # call would be billed at $0". `periodic_check` is the work
                    # class that routes to the `fast` role, which IS the priced
                    # one — so asking again that way answers rather than
                    # failing, and the remedy (price your default) stays the
                    # owner's to apply. Any other refusal is re-raised.
                    if e.code != 503:
                        raise
                    body = e.read().decode()
                    if "declares no rate" not in body:
                        raise urllib.error.HTTPError(e.url, e.code, body, e.headers, None)
                    answer = ask_claude(system, turns, work="periodic_check")
            except urllib.error.HTTPError as e:
                detail = (e.read() or b"").decode()[:200] or str(e.reason)
                # A refusal is the hub's sentence, not a crash: the element
                # draws `error` and the thread stays open.
                sock.sendall(ws_frame(json.dumps(
                    {"type": "error", "message": f"the hub refused the model call ({e.code}): {detail}"})))
                continue
            except Exception as e:  # noqa: BLE001
                sock.sendall(ws_frame(json.dumps(
                    {"type": "error", "message": f"{type(e).__name__}: {e}"})))
                continue
            remember(user, "assistant", answer)
            sock.sendall(ws_frame(json.dumps({"type": "result", "content": answer})))

    def log_message(self, *a):  # the unit's journal is noisy enough
        pass


def main():
    print(f"today: serving /leo/ui/data on :{PORT}, hub at {API}", flush=True)
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
