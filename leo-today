# The payload
# ---------------------------------------------------------------------------

def payload(grant=None, user=""):
    now = datetime.now(timezone.utc).astimezone()
    act = acting(grant)

    sources = {"events": events, "tasks": tasks, "notes": notes,
               "mail": mail, "weather": weather, "house": house,
               "money": money, "spend": spend, "box": box, "whereis": whereis}
    got, gaps, quiet = {}, [], 0
    with ThreadPoolExecutor(max_workers=len(sources)) as pool:
        futures = {k: pool.submit(fn, now, act) for k, fn in sources.items()}
        for key, fut in futures.items():
            try:
                got[key] = fut.result()
            except Quiet:
                quiet += 1
            except Gap as g:
                gaps.append({"id": key, "what": f"{key.title()} didn't answer — {g}."})
            except Exception as e:  # noqa: BLE001
                gaps.append({"id": key, "what": f"{key.title()} didn't answer — {type(e).__name__}."})

    evs = got.get("events", [])
    tks = got.get("tasks", [])
    nts = got.get("notes", [])
    mls = got.get("mail", [])

    d = {"loaded": "1",
         "greeting": greeting(now),
         "date_line": now.strftime("%-d %B · week %V"),
         "keys": [{"id": "k1", "key": "/", "does": "ask"},
                  {"id": "k2", "key": "w", "does": "rules"}]}

    if gaps and len(gaps) + quiet == len(sources):
        d["nothing_worked"] = "1"
        reasons = list(dict.fromkeys(g["what"].split(" didn't answer — ", 1)[-1] for g in gaps))
        d["why"] = ("Nothing answered: " + reasons[0]) if len(reasons) == 1 \
            else " ".join(g["what"] for g in gaps)
        return d

    if got.get("weather"):
        d["weather"] = got["weather"]
    # ---- every item the hub knows about, each with the app it opens in ----
    st = load_state(user, now)
    hidden = set(st["done"]) | set(st["later"]) | set(st["muted"])
    things = []

    def thing(iid, kind, icon, tint, what, when_="", late="", route="", dim=""):
        things.append({"id": iid, "kind": kind, "icon": icon, "tint": tint, "what": what[:110],
                       "when": when_, "late": late, "route": route, "dim": dim})

    said = {}
    for m in mls:
        thing(m["id"], "mail", "envelope", "blue", f"{m['who']} — {m['subject']}",
              "unread" if m["unread"] else "", route=f"/inbox?selectedId={m['id'][1:]}")
        said[m["id"]] = f"from {m['addr']}: {m['snippet']}"
    for e in evs:
        over = (not e["allday"]) and e["at"] + timedelta(minutes=e["mins"]) < now
        day = "" if e["at"].date() == now.date() else e["at"].strftime("%a ")
        thing(f"e{e['id']}", "event", "calendar", "purple", e["title"],
              "all day" if e["allday"] else day + clock(e["at"]),
              route=f"/calendar?day={e['at'].date().isoformat()}", dim="1" if over else "")
    for t in tks:
        thing(f"t{t['id']}", "task", "checkmark.circle", "orange", t["title"], t["when"], t["late"],
              route="/reminders")
    for h in got.get("house") or []:
        thing(item_key("home", h["what"]), "home", h["icon"], h["tint"], h["what"], h.get("detail", ""),
              route="/dashboard")
    for h in got.get("box") or []:
        thing(item_key("hub", h["what"]), "hub", h["icon"], h["tint"], h["what"], h.get("detail", ""),
              route="/logs")
    for n in nts:
        thing(f"n{n['id']}", "note", "sparkles", "teal", n["title"], n["when"],
              route=f"/feed?selectedId={n['id']}")
    for w in got.get("whereis") or []:
        if w.get("uid") != user:      # nobody needs telling where THEY are
            thing(item_key("people", w["what"]), "people", "location", "green", w["what"], w["detail"])
    if got.get("money"):
        thing("money", "money", "creditcard", "blue",
              f"{got['money']['amount']} spent this month", got["money"]["note"])
    if got.get("spend"):
        thing("spend", "hub", "cpu", got["spend"]["tint"],
              f"{got['spend']['amount']} on models this month", got["spend"]["note"],
              route="/p/costs/spend")
    _rec = load_subjects(user)
    _on = {i for sub_ in _rec["subjects"] for i in sub_["ids"]}
    count = lambda k: sum(1 for x in things if x["kind"] == k and x["id"] not in hidden  # noqa: E731
                          and not x["dim"] and (k != "mail" or x["id"] in _on))
    d["tiles"] = [
        {"id": "mail", "label": "Mail", "n": str(count("mail")), "icon": "envelope", "tint": "blue", "route": "/inbox"},
        {"id": "cal", "label": "Events", "n": str(count("event")), "icon": "calendar", "tint": "purple", "route": "/calendar"},
        {"id": "due", "label": "Due", "n": str(count("task")), "icon": "checklist", "tint": "orange", "route": "/reminders"},
        {"id": "home", "label": "Home", "n": str(count("home")), "icon": "house", "tint": "green", "route": "/dashboard"}]
    waiting = sum(1 for x in things if x["id"] in st["later"])
    things = [x for x in things if x["id"] not in hidden]

    # ---- the day, for the sidebar ----------------------------------------
    today = sorted((e for e in evs if e["at"].date() == now.date() or e["live_now"]),
                   key=lambda e: (not e["allday"], e["at"]))
    if today:
        d["rail"] = [{"id": e["id"], "time": "all day" if e["allday"] else clock(e["at"]),
                      "title": e["title"], "tint": e["tint"], "free": "", "what": "",
                      "done": "1" if e["at"] + timedelta(minutes=e["mins"]) < now else "",
                      "live": "1" if (not e["allday"] and e["at"] <= now
                                      <= e["at"] + timedelta(minutes=e["mins"])) else "",
                      "first": "1" if i == 0 else "",
                      "last": "1" if i == len(today[:SHOWN]) - 1 else "",
                      "leave": "", "tight": tight_note(today, i) if e["at"] > now else ""}
                     for i, e in enumerate(today[:SHOWN])]
    timed = [e for e in evs if not e["allday"] and e["at"] >= now]
    if timed:
        nxt = timed[0]
        # The hero draws `lead` and `time` side by side, so a phrase that
        # already ends in the clock prints it twice: at 02:10 a meeting at
        # 08:00 is >5h away, `lead` answers "At 08:00", and the card read
        # "AT 08:00  08:00".
        #
        # The old strip fired on `date() != now.date()`, which is a PROXY for
        # "the phrase ends in a clock" — true for "Tomorrow 08:00" and
        # "Monday 08:00", and false for the same-day "At 08:00" that also
        # ends in one. Keyed on the clock itself it covers all three and
        # still leaves "Now", "Started" and "In 25 minutes" alone.
        phrase = lead(nxt["at"], now)
        _clk = clock(nxt["at"])
        if phrase.endswith(_clk):
            phrase = phrase[: -len(_clk)].rstrip()
        d["now"] = {"lead": phrase, "time": clock(nxt["at"]), "title": nxt["title"],
                    "route": f"/calendar?day={nxt['at'].date().isoformat()}"}

    # ---- what the model is told: the fixed subjects, and what is new -------
    record = load_subjects(user)
    by_id = {x["id"]: x for x in things}
    homed = {i for sub_ in record["subjects"] for i in sub_["ids"]}
    aside = set(record["noise"]) | set(record["background"])
    # Not on anyone's mind, and no model needed to say so: a meeting that is
    # over, and facts that only inform. They feed the summary as context.
    quiet = lambda x: (x["kind"] == "event" and x["dim"]) or x["kind"] in ("people", "money") or x["id"] == "spend"  # noqa: E731
    fresh = [x for x in things if x["id"] not in homed and x["id"] not in aside and not quiet(x)]
    # Skipped twice by the model: stop asking. Everything but mail stays on
    # the page under "New", in the open; mail it would not judge stays off it.
    stuck = {i for i, n_ in record["asked"].items() if n_ >= 2}
    unsorted = [x for x in fresh if x["id"] in stuck and x["kind"] != "mail"]
    fresh = [x for x in fresh if x["id"] not in stuck]
    line = lambda x: (f"{x['id']} | {x['kind']} | {x['what']} | {x['when'] or '-'}"   # noqa: E731
                      + (" | LATE (overdue by this long)" if x["late"] else "")
                      + (" | (finished)" if x["dim"] else "")
                      + (f" | {said[x['id']]}" if x["id"] in said else ""))
    steady = [{"id": x["id"], "kind": x["kind"], "late": x["late"]} for x in things if not quiet(x)]
    # What the summary is ABOUT: only what is on the page. Not the promotion
    # that arrived a minute ago, not where a phone is — so filing one, or
    # somebody crossing a street, does not rewrite the words at the top.
    rekey = lambda visible: digest_of([i for i in steady if i["id"] in visible], evs)   # noqa: E731
    extras = [f"ALSO TRUE: {x['what']} ({x['when']})" for x in things if quiet(x) and x["kind"] != "event"]
    if got.get("weather"):
        w = got["weather"]
        extras.append(f"WEATHER: {w['temp']}, {w['range']}.")
    if gaps:
        extras.append("NOT AVAILABLE RIGHT NOW: " + "; ".join(g["id"] for g in gaps) + ".")
    ctx = ("EXISTING SUBJECTS — fixed; `id | title`, then what is in each:\n"
           + ("\n".join(f"{sub_['sid']} | {sub_['title']}\n"
                         + "\n".join("    " + line(by_id[i]) for i in sub_["ids"] if i in by_id)
                         for sub_ in record["subjects"]
                         if any(i in by_id for i in sub_["ids"])) or "(none yet)")
           + "\n\nNEW ITEMS — place every one (`id | source | what | when | detail`):\n"
           + ("\n".join(line(x) for x in fresh[:120]) or "(none)")
           + "\n\n" + context_for([], evs, now, extras))
    try:
        open(ask_path(user, "ctx"), "w").write(ctx)   # Ask answers from the same facts
        json.dump({x["id"]: x["what"] for x in things}, open(ask_path(user, "things"), "w"))
    except Exception as e:  # noqa: BLE001 — Ask and the sweep degrade, the page does not
        print(f"today: could not file the context: {type(e).__name__}", flush=True)

    held = organised(user, rekey(homed), ctx, now, [x["id"] for x in fresh[:120]], rekey)
    # Mail is never drawn before it has been judged. Everything else that is
    # new can wait on the page under "New"; a promotion cannot be allowed to.
    fresh = [x for x in fresh if x["kind"] != "mail"] + unsorted

    # ---- subjects: read from the record, in the record's order -------------
    states = (held or {}).get("states") or {}
    subjects_ = []
    with _ask_lock:
        running = {sid_ for (u_, sid_) in _sweeping if u_ == user}
    for sub_ in record["subjects"]:
        members = [by_id[i] for i in sub_["ids"] if i in by_id]
        # What a sweep found and the person KEPT: part of the subject now.
        members += [{"id": r["key"], "kind": "pinned", "icon": r["icon"], "tint": "gray",
                     "what": r["what"], "when": r["source"], "late": "", "route": r["route"], "dim": ""}
                    for r in sub_.get("pinned") or [] if r["key"] not in hidden]
        if members:
            kinds = [x["kind"] for x in members]
            lead_ = max(set(kinds), key=kinds.count)
            subjects_.append({"id": sub_["sid"], "title": sub_["title"],
                              "state": states.get(sub_["sid"], ""),
                              "tint": hue(sub_["sid"]), "icon": SUBJECT_ICON.get(lead_, "square.stack"),
                              "note": plural(len(members), "item"), "count": str(len(members)),
                              "real": "" if sub_["sid"] == "backlog" else "1", "sweeping": "1" if sub_["sid"] in running else "",
                              "sweep_note": "" if sub_["sid"] in running
                                            else (sub_.get("sweep") or {}).get("note", ""),
                              "found": [dict(f, id=f"{sub_['sid']}-{n}") for n, f in
                                        enumerate(sub_.get("found") or [])],
                              "rows": members})
    if fresh:
        # Not yet placed. On top, under one fixed name, until the model files it.
        subjects_.insert(0, {"id": "new", "title": "New", "state": "Being sorted into your subjects…",
                             "tint": "gray", "icon": "tray", "note": plural(len(fresh), "item"),
                             "count": str(len(fresh)), "rows": fresh})
    for sub_ in subjects_:
        sub_["rows"] = mark_last([dict(x, id=f"{sub_['id']}-{x['id']}", iid=x["id"]) for x in sub_["rows"]])
    if subjects_:
        d["subjects"] = subjects_
        d["all_note"] = plural(sum(len(x["rows"]) for x in subjects_), "item")
    elif not gaps:
        d["zero"] = "1"

    if held and (held.get("focus") or held.get("next")):
        d["brief"] = {"focus": [{"id": f"f{i}", "text": t} for i, t in enumerate(held.get("focus") or [])],
                      "next": [{"id": f"n{i}", "text": t} for i, t in enumerate(held.get("next") or [])],
                      "age": held["age"], "stale": held["stale"]}
    elif things:
        d["brief_pending"] = "1"
    if waiting:
        d["later_note"] = f"{waiting} back tomorrow" if waiting > 1 else "1 back tomorrow"
    last = st.get("last")
    if last and (now - (when(last["at"]) or now)) < timedelta(minutes=10):
        verb = {"done": "Done", "later": "Later", "mute": "Not for me"}[last["verb"]]
        d["undo"] = f"{verb}: {last['what']}"[:90]
    if got.get("weather"):
        global _scene
        _scene = scene_for(got["weather"].get("symbol", ""), now)

    told = fixes(user)
    if told:
        d["corrections"] = told
        d["corrections_note"] = plural(len(told), "rule")

    answer, pending = answer_for(user, now)
    if answer:
        d["answer"] = answer
    if pending:
        d["asking"] = pending

    d["suggestions"] = suggestions([], tks)
    note = changed_since(user, [x["id"] for x in steady])
    if note:
        d["changed"] = note
    if gaps:
        names = [g["id"].title() for g in gaps]
        d["gaps_line"] = (gaps[0]["what"].replace(" didn't answer — ", ": ", 1) if len(gaps) == 1
                          else "Not shown: " + ", ".join(names[:-1]) + " and " + names[-1] + ".")
    return d


def tight_note(today, i):  # noqa: D103
    """Back-to-back is a fact about the day worth drawing."""
    if i == 0:
        return ""
    prev = today[i - 1]
    if prev.get("allday") or today[i].get("allday") or prev["at"].date() != today[i]["at"].date():
        return ""
    gap = int((today[i]["at"] - (prev["at"] + timedelta(minutes=prev["mins"]))).total_seconds() // 60)
    if 0 <= gap <= 10:
        return f"Straight after {prev['title'][:28]} — {gap} min" if gap else \
            f"Straight after {prev['title'][:28]}"
    return ""


def suggestions(threads, tks):
    out = [{"id": "s0", "text": "What should I do first?"}]
    for t in threads[:2]:
        out.append({"id": f"s{t['id']}", "text": f"What's left on {t['title']}?"})
    if any(t["late"] for t in tks):
        out.append({"id": "sl", "text": "What's late and why?"})
    return out[:4]


def greeting(now):
    h = now.hour
    part = "morning" if h < 12 else ("afternoon" if h < 18 else "evening")
    return f"{now.strftime('%A')} {part}"


