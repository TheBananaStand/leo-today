# is written by a thread that may outlive the request, and because a restart
# between the press and the answer should cost a re-ask, not a crash.
ASK_DIR = os.path.join(DATA, "ask")
FIX_DIR = os.path.join(DATA, "fixes")
_asking = set()
_sweeping = set()
_ask_lock = threading.Lock()

