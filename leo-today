STOP = set("""a an the and or but of to in on at for with from by about into over after before
is are was were be been being do does did have has had will would can could should may might must
my your our their his her its this that these those it he she they we you i me us them not no yes
new get got make made go going went back up down out off out again more most some any each every
today tomorrow tonight morning afternoon evening week weekend month year day days time call email
reply send meeting lunch dinner call re fwd""".split())
WORD = re.compile(r"[A-Za-z][A-Za-z'’]{2,}")


def words(text):
    return [w.lower() for w in WORD.findall(text or "") if w.lower() not in STOP and len(w) > 3]


def subjects(items):
    """Group items that are about the same thing.

    A token earns a thread when it appears in at least two items **from
    different kinds** — a task and a message, a message and an event. One
    source repeating a word is a list; two sources sharing one is a subject,
    and that distinction is the whole of the rule. No model, no stored state:
    the same items always give the same threads.
    """
    index = {}
    for it in items:
        for w in set(words(it["text"])):
            index.setdefault(w, []).append(it)

    def score(bucket):
        kinds = {i["kind"] for i in bucket}
        return (len(kinds), len(bucket))

    seeds = [(w, b) for w, b in index.items() if len({i["kind"] for i in b}) >= 2]
    seeds.sort(key=lambda wb: score(wb[1]), reverse=True)

    used, threads = set(), []
    for word, bucket in seeds:
        members = [i for i in bucket if i["id"] not in used]
        if len({i["kind"] for i in members}) < 2 or len(members) < 2:
            continue
        for i in members:
            used.add(i["id"])
        threads.append((word, members))
        if len(threads) >= 3:
            break
    return threads, used


SUBJECT_ICON = {"mail": "envelope", "event": "calendar", "task": "checklist", "home": "house",
                "hub": "server.rack", "note": "sparkles", "people": "person.2", "money": "creditcard"}
_scene = ""


def scene_for(symbol, now):
    """Which sky the hero draws, from the weather's SF Symbol — the one field
    that is a vocabulary. `condition` is a tool's prose: it once read "day
    forecast for Menifee, United States"."""
    c = symbol.lower()
    kind = ("storm" if "bolt" in c else "snow" if "snow" in c or "sleet" in c
            else "rain" if "rain" in c or "drizzle" in c
            else "fog" if "fog" in c or "haze" in c
            else "cloud" if "cloud" in c else "clear")
    return f"{kind}-{'day' if 7 <= now.hour < 18 else 'night'}"


KIND_ICON = {"task": "checkmark.square", "mail": "envelope",
             "event": "calendar", "note": "sparkles"}


def build_threads(items, now):
    found, used = subjects(items)
    out = []
    for word, members in found:
        members.sort(key=lambda i: i.get("order", 9e9))
        late = sum(1 for m in members if m.get("late"))
        kinds = {m["kind"] for m in members}
        soonest = min((m["deadline"] for m in members if m.get("deadline")), default=None)
        bits = [f"{plural(len(members), 'item')} across {plural(len(kinds), 'place')}"]
        if late:
            bits.append(f"{late} late")
        if soonest:
            bits.append(f"next {short_when(soonest, now)}")
        todo = next((m for m in members if m["kind"] == "task"), None)
        out.append({
            "id": word, "tint": hue(word),
            "icon": KIND_ICON.get(next(iter(sorted(kinds))), "sparkles"),
            "title": word.capitalize(),
            "state": " · ".join(bits) + ".",
            "clock": short_when(soonest, now) if soonest else "",
            "do": todo["text"][:40] if todo else "",
            "do_id": todo["id"] if todo else "",
            "ask": f"What's left on {word.capitalize()}?",
            "strands": [{"id": m["id"], "icon": KIND_ICON.get(m["kind"], "circle"),
                         "what": m["text"][:90], "when": m.get("when", ""),
                         "late": m.get("late", ""), "done": ""}
                        for m in mark_last(members)],
        })
    return out, used


