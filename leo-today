# The day as a shape
# ---------------------------------------------------------------------------

def day_strip(evs, now):
    today = [e for e in evs if e["at"].date() == now.date() and not e["allday"]]
    lo, hi = DAY_FROM, DAY_TO
    for e in today:
        lo = min(lo, minutes(e["at"]))
        hi = max(hi, minutes(e["at"]) + e["mins"])
    lo, hi = max(0, lo), min(24 * 60, hi)
    blocks, cursor = [], lo
    for e in today:
        s, t = max(lo, minutes(e["at"])), 0
        t = min(hi, s + e["mins"])
        if s > cursor:
            blocks.append({"id": f"f{len(blocks)}", "span": str(s - cursor), "free": "1",
                           "tint": "", "label": gap_label(s - cursor, hi - lo)})
        if t > s:
            blocks.append({"id": e["id"], "span": str(t - s), "free": "", "tint": e["tint"],
                           "label": strip_label(e["title"], t - s, hi - lo)})
        cursor = max(cursor, t)
    if hi > cursor:
        blocks.append({"id": "fz", "span": str(hi - cursor), "free": "1", "tint": "",
                       "label": gap_label(hi - cursor, hi - lo)})
    pos = min(max(minutes(now), lo), hi)
    at = {"before": str(pos - lo), "after": str(hi - pos), "label": clock(now)}
    booked = sum(int(b["span"]) for b in blocks if not b["free"])
    # The biggest clear stretch used to be appended here too. It is drawn ON
    # the strip now — in the block it is actually about — so repeating it
    # under the strip is the same fact twice, four inches apart.
    note = f"{booked // 60}h {booked % 60:02d}m booked" if booked else "nothing booked"
    return blocks, at, {"from": f"{lo // 60:02d}:{lo % 60:02d}",
                        "to": f"{hi // 60:02d}:{hi % 60:02d}", "note": note}


STRIP_NOISE = re.compile(r"\b(meeting|call|sync|standup|review|session|appointment|1:1)\b", re.I)

# What the track is actually worth, in points, at a window narrow enough that
# the answer holds at every width that draws two columns. Measured off the
# 1280pt render: ~1050pt of track, `px-2` each side, `text-xs` at about 6.6pt
# a character. 700 is the NARROWEST width that still draws these labels at
# all — the markup hides them below `md:`, so a 768pt window is the floor —
# because a label the painter has to cut is worse than no label, and the rail
# beside the strip has the full name either way.
TRACK_PT, BLOCK_PAD, CHAR_PT = 700.0, 18.0, 6.6


def fits(span, total):
    """How many characters a block of `span` minutes can actually hold."""
    if not total:
        return 0
    return int((span / total * TRACK_PT - BLOCK_PAD) / CHAR_PT)


def strip_label(title, span, total):
    """The longest WHOLE-WORD name that fits the width there is.

    Three rules, each paid for by a bad render:

    * never cut mid-word — "Engineerin" reads as a glitch where an empty
      block reads as a small one;
    * drop the word every entry shares, but only from the END: stripping it
      wherever it appeared turned "Standup with the build team" into "with";
    * if not even the first word fits, draw nothing. A block too narrow for
      one honest word is a block whose label belongs in the rail instead,
      and the rail has it.
    """
    room = fits(span, total)
    if room < 4:
        return ""
    parts = title.strip().split()
    while len(parts) > 1 and STRIP_NOISE.fullmatch(parts[-1]):
        parts.pop()
    if not parts:
        return ""
    if len(parts[0]) > room:
        return ""
    out = parts[0]
    for word in parts[1:]:
        if len(out) + 1 + len(word) > room:
            break
        out += " " + word
    return out


def gap_label(span, total):
    """A gap says how long it is, when it is long enough to matter and wide
    enough to hold the words. Both halves are needed: 90 minutes is the
    threshold for caring, and the width is the threshold for reading."""
    if span < 90:
        return ""
    room = fits(span, total)
    h, m = divmod(span, 60)
    long_form = f"{h} hours clear" if not m else f"{h}h {m:02d}m clear"
    short_form = f"{h}h clear" if not m else f"{h}h{m:02d} clear"
    if room >= len(long_form):
        return long_form
    if room >= len(short_form):
        return short_form
    return "clear" if room >= 5 else ""


