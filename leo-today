def payload(grant=None, user=""):
    now = datetime.now(timezone.utc).astimezone()
    act = acting(grant)

    sources = {"events": events, "tasks": tasks, "notes": notes,
               "mail": mail, "weather": weather, "house": house,
               "money": money, "spend": spend, "box": box, "whereis": whereis}
    got, gaps = {}, []
    with ThreadPoolExecutor(max_workers=len(sources)) as pool:
        futures = {k: pool.submit(fn, now, act) for k, fn in sources.items()}
        for key, fut in futures.items():
            try:
                got[key] = fut.result()
            except Gap as g:
                gaps.append({"id": key, "what": f"{key.title()} didn't answer — {g}."})
            except Exception as e:  # noqa: BLE001
                gaps.append({"id": key, "what": f"{key.title()} didn't answer — {type(e).__name__}."})

    evs = got.get("events", [])
    tks = got.get("tasks", [])
    nts = got.get("notes", [])
    mls = got.get("mail", [])

    d = {"loaded": "1",
         "greeting": greeting(now),
         "date_line": now.strftime("%-d %B · week %V"),
         "keys": [{"id": "k1", "key": "j k", "does": "move through tasks"},
                  {"id": "k2", "key": "e", "does": "tick off"},
                  {"id": "k3", "key": "/", "does": "ask"}]}

    if len(gaps) == len(sources):
        d["nothing_worked"] = "1"
        reasons = list(dict.fromkeys(g["what"].split(" didn't answer — ", 1)[-1] for g in gaps))
        d["why"] = ("Nothing answered: " + reasons[0]) if len(reasons) == 1 \
            else " ".join(g["what"] for g in gaps)
        return d

    if got.get("weather"):
        d["weather"] = got["weather"]
    around = (got.get("house") or []) + (got.get("whereis") or []) + (got.get("box") or [])
    if around:
        d["house"] = mark_last(around[:8])
    if got.get("money"):
        d["money"] = got["money"]
    if got.get("spend"):
        d["spend"] = got["spend"]

    # The day
    if evs:
        blocks, at, span = day_strip(evs, now)
        if blocks:
            d["strip"], d["at"] = blocks, at
            d["strip_from"], d["strip_to"], d["strip_note"] = span["from"], span["to"], span["note"]
        timed = [e for e in evs if not e["allday"]]
        nxt = next((e for e in timed if e["at"] >= now), None) or (timed or evs)[-1]
        phrase = lead(nxt["at"], now)
        if nxt["at"].date() != now.date():
            phrase = phrase.rsplit(" ", 1)[0]  # the time is beside it already
        d["now"] = {"lead": phrase, "time": clock(nxt["at"]),
                    "title": nxt["title"],
                    "where": nxt["where"],
                    "len": human_len(nxt["mins"]) if not nxt["allday"] else "All day",
                    "join": "", "join_ask": "", "faces": []}
        rail, today = [], [e for e in evs if e["at"].date() == now.date() or e["live_now"]]
        for i, e in enumerate(today[:SHOWN]):
            rail.append({"id": e["id"],
                         "time": "all day" if e["allday"] else clock(e["at"]),
                         "title": e["title"],
                         "tint": e["tint"], "free": "", "what": "",
                         "done": "1" if e["at"] + timedelta(minutes=e["mins"]) < now else "",
                         "live": "1" if (not e["allday"]
                                         and e["at"] <= now <= e["at"] + timedelta(minutes=e["mins"])) else "",
                         "last": "1" if i == len(today[:SHOWN]) - 1 else "",
                         "leave": "", "tight": tight_note(today, i)})
        if rail:
            d["rail"] = rail
            d["rail_note"] = f"{len(today)} today"

    # Subjects
    items = []
    for t in tks:
        items.append({"id": f"t{t['id']}", "kind": "task", "text": t["title"], "when": t["when"],
                      "late": t["late"], "deadline": None, "order": 0})
    for m in mls:
        items.append({"id": m["id"], "kind": "mail", "text": f"{m['who']} — {m['subject']}",
                      "when": "", "late": "", "deadline": None, "order": 1})
    for e in evs:
        items.append({"id": f"e{e['id']}", "kind": "event", "text": e["title"],
                      "when": clock(e["at"]) + (" tomorrow" if e["tomorrow"] else ""),
                      "late": "", "deadline": e["at"], "order": 2})
    for n in nts:
        items.append({"id": f"n{n['id']}", "kind": "note", "text": n["title"],
                      "when": n["when"], "late": "", "deadline": None, "order": 3})

    threads, used = build_threads(items, now)
    if threads:
        d["threads"] = threads
        d["threads_note"] = (plural(len(threads), "subject") + ", "
                             + plural(sum(len(t["strands"]) for t in threads), "item"))
    elif items:
        kinds = len({i["kind"] for i in items})
        d["no_threads"] = (
            f"Nothing spans two places today — {plural(len(items), 'item')} across "
            f"{plural(kinds, 'source')}, none of them about the same thing."
        )

    # Whatever no subject claimed, and only what is due
    rest = [i for i in items if i["id"] not in used and i["kind"] in ("task", "mail")]
    # Something a person sent, then something genuinely late, then the
    # abandoned. Five months of chores at the top buries the one line on the
    # page somebody is actually waiting on.
    rest.sort(key=lambda i: (0 if i["kind"] == "mail" else 1 if i.get("late") else 2))
    loose = [{"id": i["id"], "what": i["text"][:90], "when": i.get("when", ""),
              "late": i.get("late", ""), "done": "", "icon": KIND_ICON.get(i["kind"], "circle")}
             for i in rest]
    if loose:
        shown, rest = loose[:4], loose[4:12]
        mark_last(shown)
        if rest:
            # The 4th row keeps its divider while there is more under it —
            # the hairline is what separates the list from the opener.
            shown[-1]["last"] = ""
            mark_last(rest)
            d["loose_rest"] = rest
            d["loose_more"] = f"Show {len(rest)} more"
        d["loose"] = shown
        d["loose_note"] = (f"4 of {len(loose)}" if len(loose) > 4
                           else plural(len(loose), "item"))

    # The briefing. Cached against what it is about; served stale and
    # rewritten behind the page when that changes. Never blocks.
    extras = []
    if got.get("weather"):
        w = got["weather"]
        extras.append(f"WEATHER: {w['temp']} {w['condition']}, {w['range']}.")
    if got.get("house"):
        extras.append("THE HOUSE (doors, locks, thermostats): "
                      + "; ".join(h["what"] for h in got["house"]) + ".")
    if got.get("whereis"):
        extras.append("WHERE PEOPLE ARE (a phone's own location — nothing to do with "
                      "anything else below): "
                      + "; ".join(f"{h['what']} ({h['detail']})" for h in got["whereis"]) + ".")
    if got.get("box"):
        extras.append("THIS HUB'S OWN HEALTH (software on the box, not about any person): "
                      + "; ".join(h["what"] for h in got["box"]) + ".")
    if got.get("money"):
        extras.append(f"SPENDING THIS MONTH: {got['money']['amount']} — {got['money']['note']}.")
    if got.get("spend"):
        extras.append(f"THIS HUB'S MODEL SPEND: {got['spend']['amount']}, {got['spend']['note']}.")
    if gaps:
        extras.append("NOT AVAILABLE RIGHT NOW: "
                      + "; ".join(g["id"] for g in gaps) + ".")
    # The ask path answers from exactly what the briefing was given, so the
    # two can never disagree about what today holds. Written here because
    # this is the only place that has assembled it.
    ctx = context_for(items, evs, now, extras)
    try:
        open(ask_path(user, "ctx"), "w").write(ctx)
    except Exception as e:  # noqa: BLE001 — Ask degrades, the page does not
        print(f"today: could not file the context: {type(e).__name__}", flush=True)

    br = briefing(user, items, evs, now, extras, ctx)
    if not br and (items or evs):
        d["brief_pending"] = "1"
    if br:
        mood = str(br.get("mood") or "calm").lower()
        br["tint"] = {"behind": "red", "busy": "amber"}.get(mood, "green")
        br["icon"] = {"behind": "exclamationmark.triangle", "busy": "flame"}.get(mood, "sun.max")
        told = [n for n in (br.get("notes") or []) if isinstance(n, dict) and n.get("what")]
        br["notes"] = [{"id": f"bn{i}", "what": str(n.get("what"))[:160],
                        "why": str(n.get("why") or "")[:200]} for i, n in enumerate(told[:4])]
        focus = br.get("focus") if isinstance(br.get("focus"), dict) else {}
        br["focus"] = {"what": str(focus.get("what") or "")[:140],
                       "why": str(focus.get("why") or "")[:240]}
        d["brief"] = br

    answer, pending = answer_for(user, now)
    if answer:
        d["answer"] = answer
    if pending:
        d["asking"] = pending

    d["suggestions"] = suggestions(threads, tks)
    note = changed_since(user, [i["id"] for i in items])
    if note:
        d["changed"] = note
    if gaps:
        d["gaps"] = gaps
    return d


def tight_note(today, i):  # noqa: D103
    """Back-to-back is a fact about the day worth drawing."""
    if i == 0:
        return ""
    prev = today[i - 1]
    if prev.get("allday") or today[i].get("allday") or prev["at"].date() != today[i]["at"].date():
        return ""
    gap = int((today[i]["at"] - (prev["at"] + timedelta(minutes=prev["mins"]))).total_seconds() // 60)
    if 0 <= gap <= 10:
        return f"Straight after {prev['title'][:28]} — {gap} min" if gap else \
            f"Straight after {prev['title'][:28]}"
    return ""


def suggestions(threads, tks):
    out = [{"id": "s0", "text": "What should I do first?"}]
    for t in threads[:2]:
        out.append({"id": f"s{t['id']}", "text": f"What's left on {t['title']}?"})
    if any(t["late"] for t in tks):
        out.append({"id": "sl", "text": "What's late and why?"})
    return out[:4]


def greeting(now):
    h = now.hour
    part = "morning" if h < 12 else ("afternoon" if h < 18 else "evening")
    return f"{now.strftime('%A')} {part}"


# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def do_POST(self):  # noqa: N802
        """The hub's action channel.

        The forwarded body's exact shape is the hub's, not this package's, and
        no doc on this box states it — so read the action name from either of
        the two spellings a reader would expect, and treat anything that is
        not `name`/`action` as the arguments. It logs what it actually got,
        which is how the next person finds out for certain.
        """
        if self.path.split("?")[0] != "/leo/ui/action":
            return self.send_error(404)
        try:
            n = int(self.headers.get("content-length") or 0)
            raw = self.rfile.read(n).decode() if n else "{}"
            body = json.loads(raw or "{}")
            if not isinstance(body, dict):
                raise ValueError("not an object")
        except Exception as e:  # noqa: BLE001
            return self.send_error(400, f"unreadable body: {type(e).__name__}")
        name = str(body.get("name") or body.get("action") or "")
        args = body.get("args")
        if not isinstance(args, dict):
            args = {k: v for k, v in body.items() if k not in ("name", "action")}
        user = self.headers.get("x-leo-user-id") or ""
        print(f"today: action {name!r} args={sorted(args)} user={user or '-'}", flush=True)
        try:
            out = ui_action(name, args, user)
        except Exception as e:  # noqa: BLE001 — an action never takes the page down
            print(f"today: action {name!r} failed: {type(e).__name__}: {e}", flush=True)
            out = {"ok": False, "error": type(e).__name__}
        blob = json.dumps(out).encode()
        self.send_response(200)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(blob)))
        self.end_headers()
        self.wfile.write(blob)

    def do_GET(self):  # noqa: N802
        path = self.path.split("?")[0]
        if path == "/leo/ui/data":
            body = json.dumps(payload(self.headers.get("x-leo-acting-grant"),
                                      self.headers.get("x-leo-user-id") or "")).encode()
        elif path in ("/leo/health", "/health"):
            body = b'{"ok":true}'
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *a):
        pass


def main():
    print(f"today: serving /leo/ui/data on :{PORT}, hub at {API}", flush=True)
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
