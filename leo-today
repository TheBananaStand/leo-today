STOP = set("""a an the and or but of to in on at for with from by about into over after before
is are was were be been being do does did have has had will would can could should may might must
my your our their his her its this that these those it he she they we you i me us them not no yes
new get got make made go going went back up down out off out again more most some any each every
today tomorrow tonight morning afternoon evening week weekend month year day days time call email
reply send meeting lunch dinner call re fwd""".split())
WORD = re.compile(r"[A-Za-z][A-Za-z'’]{2,}")


def words(text):
    return [w.lower() for w in WORD.findall(text or "") if w.lower() not in STOP and len(w) > 3]


def subjects(items):
    """Group items that are about the same thing.

    A token earns a thread when it appears in at least two items **from
    different kinds** — a task and a message, a message and an event. One
    source repeating a word is a list; two sources sharing one is a subject,
    and that distinction is the whole of the rule. No model, no stored state:
    the same items always give the same threads.
    """
    index = {}
    for it in items:
        for w in set(words(it["text"])):
            index.setdefault(w, []).append(it)

    def score(bucket):
        kinds = {i["kind"] for i in bucket}
        return (len(kinds), len(bucket))

    seeds = [(w, b) for w, b in index.items() if len({i["kind"] for i in b}) >= 2]
    seeds.sort(key=lambda wb: score(wb[1]), reverse=True)

    used, threads = set(), []
    for word, bucket in seeds:
        members = [i for i in bucket if i["id"] not in used]
        if len({i["kind"] for i in members}) < 2 or len(members) < 2:
            continue
        for i in members:
            used.add(i["id"])
        threads.append((word, members))
        if len(threads) >= 3:
            break
    return threads, used


KIND_ICON = {"task": "checkmark.square", "mail": "envelope",
             "event": "calendar", "note": "sparkles"}


def build_threads(items, now):
    found, used = subjects(items)
    out = []
    for word, members in found:
        members.sort(key=lambda i: i.get("order", 9e9))
        late = sum(1 for m in members if m.get("late"))
        kinds = {m["kind"] for m in members}
        soonest = min((m["deadline"] for m in members if m.get("deadline")), default=None)
        bits = [f"{len(members)} items across {len(kinds)} places"]
        if late:
            bits.append(f"{late} late")
        if soonest:
            bits.append(f"next {short_when(soonest, now)}")
        todo = next((m for m in members if m["kind"] == "task"), None)
        out.append({
            "id": word, "tint": hue(word),
            "icon": KIND_ICON.get(next(iter(sorted(kinds))), "sparkles"),
            "title": word.capitalize(),
            "state": " · ".join(bits) + ".",
            "clock": short_when(soonest, now) if soonest else "",
            "do": todo["text"][:40] if todo else "",
            "ask": f"What's left on {word}?",
            "more": f"{len(members)} items",
            "strands": [{"id": m["id"], "icon": KIND_ICON.get(m["kind"], "circle"),
                         "what": m["text"][:90], "when": m.get("when", ""),
                         "late": m.get("late", ""), "done": ""} for m in members],
        })
    return out, used


# ---------------------------------------------------------------------------
# The day as a shape
# ---------------------------------------------------------------------------

def day_strip(evs, now):
    today = [e for e in evs if e["at"].date() == now.date() and not e["allday"]]
    lo, hi = DAY_FROM, DAY_TO
    for e in today:
        lo = min(lo, minutes(e["at"]))
        hi = max(hi, minutes(e["at"]) + e["mins"])
    lo, hi = max(0, lo), min(24 * 60, hi)
    blocks, cursor = [], lo
    for e in today:
        s, t = max(lo, minutes(e["at"])), 0
        t = min(hi, s + e["mins"])
        if s > cursor:
            interior = any(not b["free"] for b in blocks)
            blocks.append({"id": f"f{len(blocks)}", "span": str(s - cursor), "free": "1",
                           "tint": "", "label": gap_label(s - cursor) if interior else ""})
        if t > s:
            blocks.append({"id": e["id"], "span": str(t - s), "free": "", "tint": e["tint"],
                           "label": strip_label(e["title"], t - s)})
        cursor = max(cursor, t)
    if hi > cursor:
        blocks.append({"id": "fz", "span": str(hi - cursor), "free": "1", "tint": "",
                       "label": ""})
    pos = min(max(minutes(now), lo), hi)
    at = {"before": str(pos - lo), "after": str(hi - pos), "label": clock(now)}
    booked = sum(int(b["span"]) for b in blocks if not b["free"])
    note = f"{booked // 60}h {booked % 60:02d}m booked" if booked else "nothing booked"
    biggest = max((int(b["span"]) for b in blocks if b["free"]), default=0)
    if biggest >= 90:
        note += f" · {biggest // 60}h clear"
    return blocks, at, {"from": f"{lo // 60:02d}:{lo % 60:02d}",
                        "to": f"{hi // 60:02d}:{hi % 60:02d}", "note": note}


STRIP_NOISE = re.compile(r"\b(meeting|call|sync|standup|review|session|appointment|1:1)\b", re.I)


def strip_label(title, span):
    """The shortest name that is still the thing, for the width there is.

    Roughly eight characters fit per 30 minutes. Dropping the word every
    entry shares — "Meeting" — buys back more room than truncating does,
    because what distinguishes two entries is never the word they have in
    common.
    """
    room = max(0, (span // 30) * 8)
    if room < 6:
        return ""
    # Only from the END, and never the last word standing. Stripping a
    # noise word wherever it appeared turned "Standup with the build team"
    # into "with": the word every entry shares is only safe to drop when it
    # is the one trailing the name, not when it is the name's head.
    parts = title.strip().split()
    while len(parts) > 1 and STRIP_NOISE.fullmatch(parts[-1]):
        parts.pop()
    name = " ".join(parts).strip(" -–—·,") or title.strip()
    if len(name) <= room:
        return name
    cut = name[:room].rsplit(" ", 1)[0]
    # A label should not end on a preposition — "1:1 with" reads as cut off
    # by accident rather than shortened on purpose.
    while " " in cut and cut.rsplit(" ", 1)[-1].lower() in STOP:
        cut = cut.rsplit(" ", 1)[0]
    return cut if len(cut) >= 3 else name[:room]


def gap_label(span):
    """A gap says how long it is only when it is long enough to matter."""
    if span < 90:
        return ""
    h, m = divmod(span, 60)
    return f"{h} hours clear" if not m else f"{h}h {m:02d}m clear"


