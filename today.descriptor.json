{
  "name": "today",
  "label": "Today",
  "description": "What today holds, at a glance \u2014 the next thing, what is due, what is worth knowing.",
  "details": "One page assembled from whatever this hub can answer: the calendar, reminders and the feed. Every block is gated on having something in it, so the page is as long as the day is busy. Each source is fetched on its own \u2014 one that fails or times out leaves its block off the page and a line at the foot saying so, rather than taking the page down.",
  "setup_hint": "Nothing to set up. Enable it and open Today.",
  "use_cases": [
    "What does my day look like?",
    "What's overdue?"
  ],
  "icon": "sun.max",
  "category": "package",
  "kind": "app",
  "default_enabled": false,
  "pages": [
    {
      "path": "today",
      "label": "Today",
      "icon": "sun.max",
      "show_in_nav": true
    }
  ],
  "ui": {
    "today": {
      "kind": "html",
      "html": "<div id=\"today\" subset=\"15\" class=\"h-full flex flex-col overflow-y-auto bg-canvas\">\n\n  <!-- ======================= ROW FORMS =======================\n\n       Three rules hold across every template below, because breaking any one\n       of them is what the last pass got wrong:\n\n       * A fixed height on a box that holds payload text CLIPS it. Every row\n         that carries a title is `min-h-\u2026`, never `h-\u2026`.\n       * A trailing meta column (`{x.when}`, a count) is `shrink-0`, or the\n         flex row steals its width and wraps \"4 of 6\" into three lines.\n       * A divider belongs to the row ABOVE the gap, so the last row has\n         none \u2014 `if=\"!x.last\"` on a separate hairline, inset to the text.\n  -->\n\n  <!-- A strand: one source's contribution to a thread. The glyph says where\n       it came from, so a thread can hold a flight, a task and a message\n       without three different row shapes. It is the strand's whole reason\n       for being there, so it carries the thread's tint rather than being\n       the faintest thing in the row. -->\n  <template name=\"strand\">\n    <li id=\"s-{s.id}\" class=\"flex flex-col\">\n      <div class=\"flex items-center gap-3 min-h-9 py-1\">\n        <img icon=\"{s.icon}\" alt=\"\" class=\"size-3.5 shrink-0 text-tint\">\n        <span if=\"!s.done\" class=\"flex-1 min-w-0 text-sm truncate\">{s.what}</span>\n        <span if=\"s.done\" class=\"flex-1 min-w-0 text-sm text-muted line-through truncate\">{s.what}</span>\n        <span if=\"s.late\" class=\"shrink-0 px-2 py-0.5 rounded-full text-xs font-medium bg-danger text-danger tabular-nums\">{s.when}</span>\n        <span if=\"!s.late\" class=\"shrink-0 text-xs text-muted tabular-nums\">{s.when}</span>\n      </div>\n      <span if=\"!s.last\" class=\"ml-6 border-t\"></span>\n    </li>\n  </template>\n\n  <!-- A thread: everything about ONE subject, whatever it arrived as. This\n       is the whole of version 2 \u2014 the page is a list of subjects, not a\n       list of sources. -->\n  <template name=\"thread\">\n    <article id=\"th-{t.id}\" tint=\"{t.tint}\" class=\"flex flex-col gap-3 p-4 rounded-xl bg-surface\">\n      <div class=\"flex items-start gap-3\">\n        <span class=\"size-9 shrink-0 flex items-center justify-center rounded-lg bg-tint-wash\">\n          <img icon=\"{t.icon}\" alt=\"\" class=\"size-4 text-tint\">\n        </span>\n        <div class=\"flex flex-col gap-0.5 min-w-0 flex-1\">\n          <span class=\"text-base font-semibold truncate\">{t.title}</span>\n          <span class=\"text-xs text-secondary line-clamp-2\">{t.state}</span>\n        </div>\n        <span if=\"t.clock\" class=\"shrink-0 px-2.5 py-1 rounded-full text-xs font-semibold bg-tint-wash text-tint\">{t.clock}</span>\n      </div>\n      <ul class=\"flex flex-col\">\n        <use template=\"strand\" each=\"s in t.strands\"></use>\n      </ul>\n      <!-- The primary carries a fill; the secondary is plain text. Accent is\n           NOT spent here \u2014 a page with four threads would be four green\n           buttons, and the rubric allows one primary on a screen. The weight\n           difference does the work instead. -->\n      <div if=\"t.do\" class=\"flex flex-wrap items-center gap-2\">\n        <a id=\"do-{t.id}\" action=\"complete\" args=\"id={t.do_id}\"\n           class=\"shrink-0 max-w-xs min-h-10 px-4 flex items-center rounded-lg text-sm font-semibold bg-elevated truncate\">{t.do}</a>\n        <a if=\"t.ask\" id=\"ask-{t.id}\" action=\"ask\" args=\"text={t.ask}\"\n           class=\"shrink-0 max-w-xs min-h-10 px-3 flex items-center rounded-lg text-sm font-medium text-secondary truncate\">{t.ask}</a>\n      </div>\n      <div if=\"!t.do\" class=\"flex flex-wrap items-center gap-2\">\n        <a if=\"t.ask\" id=\"askonly-{t.id}\" action=\"ask\" args=\"text={t.ask}\"\n           class=\"shrink-0 max-w-xs min-h-10 px-4 flex items-center rounded-lg text-sm font-medium bg-elevated truncate\">{t.ask}</a>\n      </div>\n    </article>\n  </template>\n\n  <!-- A loose end: something that belongs to no thread. One line, because\n       that is all it is worth. The tick is its own press and the text is\n       another, side by side rather than nested \u2014 the subset refuses a press\n       inside a press, and nesting them is also what stopped `j k` working. -->\n  <template name=\"loose\">\n    <li id=\"l-{x.id}\" class=\"flex flex-col\">\n      <div class=\"flex items-center gap-1 min-h-11 px-3\">\n        <span class=\"flex items-center justify-center shrink-0 size-11\">\n          <input type=\"checkbox\" id=\"tick-{x.id}\" checked=\"{x.done}\" change=\"complete\"\n                 args=\"id={x.id}\" shortcut=\"e\" aria-label=\"Tick off {x.what}\">\n        </span>\n        <a id=\"pick-{x.id}\" select=\"loose_sel={x.id}\" selected=\"loose_sel={x.id}\"\n           class=\"flex items-center gap-3 flex-1 min-w-0 min-h-11 px-1 rounded-lg selected:bg-accent-wash\">\n          <span if=\"!x.done\" class=\"flex-1 min-w-0 text-sm truncate\">{x.what}</span>\n          <span if=\"x.done\" class=\"flex-1 min-w-0 text-sm text-muted line-through truncate\">{x.what}</span>\n          <span if=\"x.late\" class=\"shrink-0 px-2 py-0.5 rounded-full text-xs font-medium bg-danger text-danger tabular-nums\">{x.when}</span>\n          <span if=\"!x.late\" class=\"shrink-0 text-xs text-muted tabular-nums\">{x.when}</span>\n        </a>\n      </div>\n      <span if=\"!x.last\" class=\"ml-14 border-t\"></span>\n    </li>\n  </template>\n\n  <template name=\"moment\">\n    <li id=\"m-{m.id}\" class=\"flex gap-3\">\n      <span class=\"w-12 shrink-0 pt-0.5 text-right text-xs text-muted tabular-nums\">{m.time}</span>\n      <div class=\"flex flex-col items-center shrink-0 w-3\">\n        <span if=\"!m.free\" tint=\"{m.tint}\" class=\"size-2.5 rounded-full bg-tint\"></span>\n        <span if=\"m.free\" class=\"size-2.5 rounded-full border-2 border-muted\"></span>\n        <!-- `bg-elevated` is one step off `bg-surface` and vanishes entirely\n             once the card is drawn as glass over a wallpaper \u2014 measured on\n             the Mac, where the rail read as loose dots. A role border has a\n             colour of its own and survives the material. -->\n        <span if=\"!m.last\" class=\"flex-1 border-l border-muted\"></span>\n      </div>\n      <div class=\"flex flex-col gap-1 min-w-0 flex-1 pb-4\">\n        <span if=\"m.free\" class=\"text-xs text-muted italic\">{m.what}</span>\n        <div if=\"!m.free\" class=\"flex items-center gap-2 min-w-0\">\n          <span if=\"!m.done\" class=\"flex-1 min-w-0 text-sm truncate\">{m.title}</span>\n          <span if=\"m.done\" class=\"flex-1 min-w-0 text-sm text-muted truncate\">{m.title}</span>\n          <span if=\"m.live\" class=\"shrink-0 px-2 py-0.5 rounded-full text-xs font-medium bg-accent-wash text-accent\">Now</span>\n        </div>\n        <div if=\"m.leave\" class=\"flex items-center gap-1.5\">\n          <img icon=\"figure.walk\" alt=\"\" tint=\"amber\" class=\"size-3 shrink-0 text-tint\">\n          <span tint=\"amber\" class=\"text-xs text-tint tabular-nums\">{m.leave}</span>\n        </div>\n        <div if=\"m.tight\" class=\"flex items-center gap-1.5\">\n          <img icon=\"exclamationmark.triangle\" alt=\"\" tint=\"amber\" class=\"size-3 shrink-0 text-tint\">\n          <span tint=\"amber\" class=\"text-xs text-tint line-clamp-2\">{m.tight}</span>\n        </div>\n      </div>\n    </li>\n  </template>\n\n  <!-- A fact about the world around you. Same left edge as a loose end, so\n       the two lists in the same column share a text column. -->\n  <template name=\"fact\">\n    <li id=\"x-{x.id}\" class=\"flex flex-col\">\n      <div class=\"flex items-start gap-3 min-h-11 px-4 py-2.5\">\n        <img icon=\"{x.icon}\" alt=\"\" tint=\"{x.tint}\" class=\"size-4 mt-0.5 shrink-0 text-tint\">\n        <div class=\"flex flex-col gap-0.5 min-w-0 flex-1\">\n          <span class=\"text-sm line-clamp-2\">{x.what}</span>\n          <span if=\"x.detail\" class=\"text-xs text-muted truncate\">{x.detail}</span>\n        </div>\n      </div>\n      <span if=\"!x.last\" class=\"ml-11 border-t\"></span>\n    </li>\n  </template>\n\n  <div class=\"flex flex-col gap-5 w-full max-w-7xl mx-auto px-6 py-6 lg:px-8\">\n\n    <!-- ===================== THE MASTHEAD =====================\n         One card, not five. Over a wallpaper every separate translucent\n         slab costs contrast at its own edge and the page reads as murky\n         and unanchored; the same content on ONE surface, divided by\n         hairlines, reads as composed.\n\n         Every divider is `-mx-5 px-5 border-t`: the negative margin pulls\n         the rule out to the card's own edge and the padding puts the\n         content back, so a hairline reads as a division of the card rather\n         than as a line floating inside it. Each of the three regions after\n         the header carries one \u2014 there is no first-divider special case,\n         because the header is not one of them. -->\n    <section id=\"masthead\" class=\"flex flex-col gap-4 p-5 rounded-xl bg-surface\">\n      <header id=\"bar\" class=\"flex items-center gap-3\">\n        <div class=\"flex flex-col gap-0.5 min-w-0 flex-1\">\n          <span class=\"text-2xl font-bold truncate\">{greeting}</span>\n          <span class=\"text-sm text-muted truncate\">{date_line}</span>\n        </div>\n        <!-- What changed while you were away. A Today page you check six times\n             a day needs to say what is NEW, or you re-read it six times \u2014 and\n             a phone is where you check it six times, so this is not the thing\n             to drop at the narrow end. It is a press, so it is the accent:\n             green is Leo's only interactive colour. -->\n        <a if=\"changed\" id=\"changed\" action=\"show_changed\"\n           class=\"flex shrink-0 items-center gap-2 px-3 h-9 rounded-full bg-accent-wash\">\n          <span class=\"size-1.5 rounded-full bg-accent\"></span>\n          <span class=\"text-xs font-medium text-accent truncate\">{changed}</span>\n        </a>\n        <!-- `bg-surface` here was invisible: the chip sat on a card of the\n             same token. One step up, and the same height and radius as the\n             pill beside it. -->\n        <div if=\"weather\" class=\"flex items-center gap-2 shrink-0 px-3 h-9 rounded-full bg-elevated\">\n          <img icon=\"{weather.symbol}\" alt=\"{weather.condition}\" tint=\"{weather.tint}\" class=\"size-4 text-tint\">\n          <span class=\"text-sm font-semibold tabular-nums\">{weather.temp}</span>\n          <span class=\"hidden md:flex text-xs text-muted tabular-nums\">{weather.range}</span>\n        </div>\n      </header>\n\n      <!-- ===================== THE BRIEFING =====================\n           The reason the page is open. Written by a model, but never while\n           you wait: it is cached against a digest of what it is about, served\n           stale the moment that changes, and rewritten behind the page. The\n           age is always shown, because a briefing whose age you cannot see is\n           one you cannot trust. -->\n      <section if=\"brief\" id=\"brief\" tint=\"{brief.tint}\" class=\"flex flex-col gap-4 -mx-5 px-5 pt-4 border-t\">\n        <div class=\"flex items-start gap-4\">\n          <span class=\"size-8 md:size-10 shrink-0 flex items-center justify-center rounded-lg bg-tint-wash\">\n            <img icon=\"{brief.icon}\" alt=\"\" class=\"size-4 md:size-5 text-tint\">\n          </span>\n          <span class=\"flex-1 min-w-0 text-lg md:text-xl font-semibold\">{brief.headline}</span>\n          <div class=\"flex flex-col items-end gap-1 shrink-0\">\n            <span if=\"brief.age\" class=\"text-xs text-muted tabular-nums\">{brief.age}</span>\n            <span if=\"brief.stale\" class=\"flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-elevated\">\n              <span class=\"size-1.5 rounded-full bg-tint animate-pulse\"></span>\n              <span class=\"text-xs text-secondary\">rewriting</span>\n            </span>\n          </div>\n        </div>\n\n        <!-- Where the time goes. One thing, and why that one. The glyph is\n             NOT `text-tint`: the tint here is the day's mood, and a focus\n             marker that turns red on a bad day reads as an error about the\n             thing you are being told to do. -->\n        <div if=\"brief.focus.what\" id=\"brief-focus\" class=\"flex items-start gap-3 p-4 rounded-lg bg-elevated\">\n          <img icon=\"target\" alt=\"\" class=\"size-4 mt-0.5 shrink-0 text-secondary\">\n          <div class=\"flex flex-col gap-1 min-w-0 flex-1\">\n            <span class=\"text-sm font-semibold\">{brief.focus.what}</span>\n            <span if=\"brief.focus.why\" class=\"text-xs text-secondary line-clamp-3\">{brief.focus.why}</span>\n          </div>\n        </div>\n\n        <!-- What to be thinking about next. -->\n        <div if=\"brief.notes\" class=\"grid gap-x-6 gap-y-3 md:grid-cols-2\">\n          <div each=\"n in brief.notes\" id=\"bn-{n.id}\" class=\"flex items-start gap-2.5 min-w-0\">\n            <span class=\"size-1.5 mt-2 shrink-0 rounded-full bg-tint\"></span>\n            <div class=\"flex flex-col gap-0.5 min-w-0 flex-1\">\n              <span class=\"text-sm line-clamp-2\">{n.what}</span>\n              <span if=\"n.why\" class=\"text-xs text-muted line-clamp-2\">{n.why}</span>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- The first briefing is still being written. Say so rather than\n           showing a hole where the page's whole point goes. Same divider as\n           the real thing, so the card does not change shape when it lands. -->\n      <section if=\"brief_pending\" id=\"brief-pending\" class=\"flex items-center gap-4 -mx-5 px-5 pt-4 border-t\">\n        <span class=\"size-10 shrink-0 rounded-lg bg-elevated animate-pulse\"></span>\n        <div class=\"flex flex-col gap-1.5 min-w-0 flex-1\">\n          <span class=\"h-3 w-64 rounded bg-elevated animate-pulse\"></span>\n          <span class=\"text-xs text-muted\">Reading your day\u2026</span>\n        </div>\n      </section>\n\n      <!-- ===================== THE DAY, AS ONE OBJECT =====================\n           Not a list of rows that happen to be in order: a strip where each\n           block is as wide as it is long, so a 2h review looks like a 2h\n           review and the hole at noon is a hole. Both the blocks and the\n           playhead come from `grow`, so the shape is the payload's and\n           nothing here computes.\n\n           The playhead and the axis sit in boxes with the SAME `px-1` as the\n           track's own `p-1`. Without it they are measured against the outer\n           width and every reading is offset by 4pt at each end \u2014 small, and\n           always in the direction that makes the marker disagree with the\n           block it is pointing at. -->\n      <section if=\"strip\" id=\"strip\" class=\"flex flex-col -mx-5 px-5 pt-4 border-t\">\n        <div class=\"flex items-stretch gap-1 h-9 p-1 rounded-lg bg-elevated\">\n          <div each=\"b in strip\" id=\"b-{b.id}\" grow=\"{b.span}\" tint=\"{b.tint}\" class=\"flex min-w-0\">\n            <div if=\"!b.free\" class=\"flex flex-1 items-center px-2 rounded overflow-hidden bg-tint-wash\">\n              <span class=\"hidden md:flex text-xs font-medium text-tint truncate\">{b.label}</span>\n            </div>\n            <div if=\"b.free\" class=\"flex flex-1 items-center justify-center px-1 overflow-hidden\">\n              <span class=\"text-xs text-muted truncate\">{b.label}</span>\n            </div>\n          </div>\n        </div>\n        <div class=\"flex items-start px-1\">\n          <div grow=\"{at.before}\"></div>\n          <div class=\"flex flex-col items-center shrink-0\">\n            <span class=\"w-0.5 h-2 bg-accent\"></span>\n            <span class=\"text-xs font-semibold text-accent tabular-nums\">{at.label}</span>\n          </div>\n          <div grow=\"{at.after}\"></div>\n        </div>\n        <div class=\"flex items-center px-1 pt-1\">\n          <span class=\"flex-1 min-w-0 text-xs text-muted tabular-nums\">{strip_from}</span>\n          <span class=\"flex-1 min-w-0 text-xs text-secondary text-center truncate\">{strip_note}</span>\n          <span class=\"flex-1 min-w-0 text-xs text-muted text-right tabular-nums\">{strip_to}</span>\n        </div>\n      </section>\n\n      <!-- The next thing. `text-3xl` is the top of Leo's scale; the old\n           `text-4xl` was off it, and it made a clock the largest thing on a\n           page whose largest thing should be what the day is about. -->\n      <header if=\"now\" id=\"now\" class=\"flex items-center gap-5 -mx-5 px-5 pt-4 border-t\">\n        <div class=\"flex flex-col gap-0.5 shrink-0\">\n          <span class=\"text-xs font-semibold text-secondary uppercase\">{now.lead}</span>\n          <span class=\"text-3xl font-bold tabular-nums\">{now.time}</span>\n        </div>\n        <div class=\"flex flex-col gap-0.5 min-w-0 flex-1\">\n          <span class=\"text-base font-medium line-clamp-1\">{now.title}</span>\n          <span if=\"now.where\" class=\"text-xs text-muted truncate\">{now.where}</span>\n        </div>\n        <span if=\"now.len\" class=\"hidden md:flex shrink-0 px-2.5 py-1 rounded-full text-xs font-medium bg-elevated text-secondary tabular-nums\">{now.len}</span>\n        <div if=\"now.faces\" class=\"hidden md:flex items-center gap-1.5 shrink-0\">\n          <span each=\"f in now.faces\" id=\"nf-{f.id}\" tint=\"{f.tint}\"\n                class=\"size-8 flex items-center justify-center rounded-full bg-tint-wash\">\n            <span class=\"text-xs font-semibold text-tint\">{f.initials}</span>\n          </span>\n        </div>\n        <a if=\"now.join\" id=\"join\" action=\"ask\" args=\"text={now.join_ask}\" shortcut=\"enter\"\n           class=\"shrink-0 h-10 px-5 flex items-center rounded-lg text-sm font-semibold bg-accent text-on-accent\">{now.join}</a>\n      </header>\n    </section>\n\n    <!-- NOTHING answered. A partial failure is the quiet footer at the foot\n         of this page; this is the other case, and it gets a real state with\n         a way out rather than a blank page. The two whole-page states are\n         one shape \u2014 same card, same inset, same icon size \u2014 because two\n         empty states in two visual languages is how a page stops reading as\n         one page. -->\n    <div if=\"nothing_worked\" id=\"unreachable\" class=\"flex flex-col items-center gap-3 py-14 rounded-xl bg-surface\">\n      <img icon=\"wifi.exclamationmark\" alt=\"\" tint=\"amber\" class=\"size-10 text-tint\">\n      <span class=\"text-lg font-semibold\">Couldn't put today together</span>\n      <span class=\"max-w-prose px-6 text-sm text-muted text-center\">{why}</span>\n      <a id=\"retry\" action=\"refresh\" shortcut=\"r\"\n         class=\"mt-1 h-10 px-5 flex items-center rounded-lg text-sm font-semibold bg-accent text-on-accent\">Try again</a>\n    </div>\n\n    <div if=\"all_clear\" id=\"all-clear\" class=\"flex flex-col items-center gap-3 py-14 rounded-xl bg-surface\">\n      <img icon=\"checkmark.circle\" alt=\"\" tint=\"green\" class=\"size-10 text-tint\">\n      <span class=\"text-lg font-semibold\">Nothing on today</span>\n      <span class=\"max-w-prose px-6 text-sm text-muted text-center\">No events, nothing due and nothing new since you last looked.</span>\n    </div>\n\n    <!-- The left column is the work and the right is the day around it. The\n         house facts moved right: with them on the left the page ran ~600pt\n         longer on one side than the other at every window width that shows\n         two columns, which is a third of the page empty under the fold. -->\n    <div class=\"grid gap-5 lg:grid-cols-[1.4fr_1fr]\">\n\n      <!-- ---------- LEFT: the work, by subject ---------- -->\n      <div class=\"flex flex-col gap-5 min-w-0\">\n\n        <section if=\"threads\" id=\"threads\" class=\"flex flex-col gap-3\">\n          <div class=\"flex items-end justify-between gap-4\">\n            <h2 class=\"text-xs font-semibold text-secondary uppercase\">What's live</h2>\n            <span class=\"shrink-0 text-xs text-muted\">{threads_note}</span>\n          </div>\n          <use template=\"thread\" each=\"t in threads\"></use>\n        </section>\n\n        <section if=\"loose\" id=\"loose\" class=\"flex flex-col gap-3\">\n          <div class=\"flex items-end justify-between gap-4\">\n            <h2 class=\"text-xs font-semibold text-secondary uppercase\">Loose ends</h2>\n            <span class=\"shrink-0 text-xs text-muted tabular-nums\">{loose_note}</span>\n          </div>\n          <ul keys=\"loose_sel\" class=\"flex flex-col rounded-xl bg-surface overflow-hidden\">\n            <use template=\"loose\" each=\"x in loose\"></use>\n          </ul>\n          <!-- Why nothing clustered into a thread. It used to live inside the\n               header of this section, which is gated on there BEING loose\n               ends \u2014 so the sentence explaining an empty page was unreachable\n               on an empty page. It is its own block now. -->\n          <span if=\"no_threads\" class=\"text-xs text-muted line-clamp-2\">{no_threads}</span>\n        </section>\n\n      </div>\n\n      <!-- ---------- RIGHT: time, and the world ---------- -->\n      <div class=\"flex flex-col gap-5 min-w-0\">\n        <section if=\"rail\" id=\"day\" class=\"flex flex-col gap-3\">\n          <div class=\"flex items-end justify-between gap-4\">\n            <h2 class=\"text-xs font-semibold text-secondary uppercase\">The day</h2>\n            <span class=\"shrink-0 text-xs text-muted tabular-nums\">{rail_note}</span>\n          </div>\n          <ul class=\"flex flex-col p-4 pb-0 rounded-xl bg-surface\">\n            <use template=\"moment\" each=\"m in rail\"></use>\n          </ul>\n        </section>\n\n        <section if=\"house\" id=\"house\" class=\"flex flex-col gap-3\">\n          <h2 class=\"text-xs font-semibold text-secondary uppercase\">Around you</h2>\n          <ul class=\"flex flex-col rounded-xl bg-surface overflow-hidden\">\n            <use template=\"fact\" each=\"x in house\"></use>\n          </ul>\n        </section>\n\n        <!-- Two different monies, so two blocks: what the household spent,\n             and what this hub's own models cost. One number labelled\n             \"spending\" covering both would be a lie in whichever direction\n             you read it.\n\n             Both are the same card now \u2014 same type size, same padding, same\n             rhythm, and the note UNDER the number rather than squeezed in\n             beside it. Right-aligning a two-line note against a baseline put\n             its first line in mid-air and orphaned the last word of it. -->\n        <section if=\"money\" id=\"money\" class=\"flex flex-col gap-3\">\n          <h2 class=\"text-xs font-semibold text-secondary uppercase\">Spending</h2>\n          <div class=\"flex flex-col gap-1 p-4 rounded-xl bg-surface\">\n            <span class=\"text-2xl font-bold tabular-nums\">{money.amount}</span>\n            <span class=\"text-xs text-muted line-clamp-2\">{money.note}</span>\n          </div>\n        </section>\n\n        <section if=\"spend\" id=\"spend\" class=\"flex flex-col gap-3\">\n          <h2 class=\"text-xs font-semibold text-secondary uppercase\">Leo's own cost</h2>\n          <div class=\"flex flex-col gap-3 p-4 rounded-xl bg-surface\">\n            <div class=\"flex flex-col gap-1\">\n              <span class=\"text-2xl font-bold tabular-nums\">{spend.amount}</span>\n              <span class=\"text-xs text-muted line-clamp-2\">{spend.note}</span>\n            </div>\n            <div class=\"flex flex-col gap-1\">\n              <div tint=\"{spend.tint}\" class=\"flex items-center h-1.5 rounded-full bg-elevated overflow-hidden\">\n                <div grow=\"{spend.used}\" class=\"h-1.5 bg-tint\"></div>\n                <div grow=\"{spend.rest}\" class=\"h-1.5\"></div>\n              </div>\n              <!-- A bar with no scale is a shape, not a figure. -->\n              <div if=\"spend.cap\" class=\"flex items-center justify-between gap-3\">\n                <span class=\"text-xs text-muted\">{spend.scale}</span>\n                <span class=\"text-xs text-muted tabular-nums\">{spend.cap}</span>\n              </div>\n            </div>\n          </div>\n        </section>\n\n      </div>\n    </div>\n\n    <section if=\"!nothing_worked\" id=\"ask\" class=\"flex flex-col gap-3\">\n      <h2 class=\"text-xs font-semibold text-secondary uppercase\">Ask</h2>\n      <div class=\"flex flex-col p-4 rounded-xl bg-surface\">\n        <div if=\"suggestions\" class=\"flex flex-wrap items-center gap-2 pb-4 border-b\">\n          <a each=\"s in suggestions\" id=\"sg-{s.id}\" action=\"ask\" args=\"text={s.text}\"\n             class=\"min-h-10 px-3.5 flex items-center shrink-0 rounded-full text-sm font-medium bg-elevated\">{s.text}</a>\n        </div>\n        <form id=\"compose\" action=\"ask\" class=\"flex items-center gap-2 pt-4\">\n          <input bind=\"form.message\" placeholder=\"Ask about today\" shortcut=\"/\" required\n                 class=\"flex-1 max-w-2xl h-10 min-w-0\">\n          <button action=\"ask\" args=\"text={$.form.message}\" shortcut=\"enter\" disabled=\"!$.form.message\"\n                  class=\"shrink-0 h-10 px-5 rounded-lg bg-accent text-on-accent\">Ask</button>\n        </form>\n      </div>\n    </section>\n\n    <!-- What did not answer. A heading, because six unlabelled amber lines\n         at the foot of a page read as six things being wrong with the page\n         rather than as a note about its sources \u2014 and one line each, because\n         the producer can put a hub error body in here and `line-clamp-2` let\n         a JSON blob take two full-width lines. -->\n    <footer if=\"gaps\" id=\"gaps\" class=\"flex flex-col gap-2 pt-1\">\n      <h2 class=\"text-xs font-semibold text-secondary uppercase\">Didn't answer</h2>\n      <div each=\"g in gaps\" id=\"gap-{g.id}\" class=\"flex items-center gap-2 min-w-0\">\n        <img icon=\"exclamationmark.triangle\" alt=\"\" class=\"size-3.5 shrink-0 text-muted\">\n        <span class=\"min-w-0 flex-1 text-xs text-muted truncate\">{g.what}</span>\n      </div>\n    </footer>\n\n    <footer if=\"keys\" id=\"keys\" class=\"flex flex-wrap items-center gap-x-5 gap-y-2 pb-2\">\n      <div each=\"k in keys\" id=\"k-{k.id}\" class=\"flex items-center gap-1.5\">\n        <span class=\"px-1.5 h-5 flex items-center rounded bg-elevated text-xs font-mono text-secondary\">{k.key}</span>\n        <span class=\"text-xs text-muted\">{k.does}</span>\n      </div>\n    </footer>\n  </div>\n</div>\n",
      "title": "Today",
      "refreshOn": [
        "reminders",
        "feed",
        "calendar",
        "email",
        "notifications",
        "today"
      ],
      "actions": {
        "complete": {
          "method": "PATCH",
          "path": "/api/reminders/items/{args.id}/toggle",
          "body": {},
          "refresh": "reload"
        },
        "ask": {
          "kind": "setState",
          "key": "form.message",
          "value": "{args.text}"
        },
        "refresh": {
          "method": "GET",
          "path": "/api/packages/today/ui/data",
          "refresh": "reload"
        },
        "show_changed": {
          "method": "GET",
          "path": "/api/packages/today/ui/data",
          "refresh": "reload"
        }
      }
    }
  },
  "fields": [
    {
      "key": "today_graph_token",
      "label": "Graph token",
      "field_type": "password",
      "required": false
    }
  ],
  "entitlements": {
    "graph_scopes": [
      "calendar:read",
      "reminders:read",
      "feed:read",
      "hub_tools:read",
      "hub_tools:invoke",
      "inference:messages",
      "surfaces:refresh",
      "finance:read",
      "costs:read",
      "locations:read",
      "people:read",
      "scheduler:read",
      "releases:read"
    ],
    "settings_read": [
      "today_graph_token"
    ],
    "inference": {
      "classes": [
        "prompts"
      ],
      "purpose": "to answer questions about what is on the person's Today screen"
    }
  },
  "app": {
    "repo": "https://github.com/TheBananaStand/leo-today",
    "branch": "main",
    "build": "make",
    "bin": "leo-today",
    "port": 8477,
    "supervised": false
  }
}
