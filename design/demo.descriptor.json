{
  "name": "today",
  "label": "Today",
  "description": "What today holds, at a glance \u2014 the design study, on sample data.",
  "details": "Nothing is live. It serves one sample payload so the markup can be judged in the real app with the platform's own controls, type and spacing.",
  "setup_hint": "Nothing to set up.",
  "icon": "sun.max",
  "category": "package",
  "kind": "app",
  "default_enabled": false,
  "pages": [
    {
      "path": "today",
      "label": "Today",
      "icon": "sun.max",
      "show_in_nav": true
    }
  ],
  "ui": {
    "today": {
      "kind": "html",
      "html": "<div id=\"today\" subset=\"14\" class=\"h-full flex flex-col overflow-y-auto bg-canvas\">\n\n  <!-- ======================= ROW FORMS ======================= -->\n\n  <!-- A strand: one source's contribution to a thread. The glyph says where\n       it came from, so a thread can hold a flight, a task and a message\n       without three different row shapes. -->\n  <template name=\"strand\">\n    <li id=\"s-{s.id}\" class=\"flex items-center gap-3 h-9\">\n      <img icon=\"{s.icon}\" alt=\"\" class=\"size-3.5 shrink-0 text-muted\">\n      <span if=\"!s.done\" class=\"flex-1 min-w-0 text-sm truncate\">{s.what}</span>\n      <span if=\"s.done\" class=\"flex-1 min-w-0 text-sm text-muted truncate\">{s.what}</span>\n      <span if=\"s.late\" class=\"shrink-0 px-2 py-0.5 rounded-full text-xs font-medium bg-danger text-danger tabular-nums\">{s.when}</span>\n      <span if=\"!s.late\" class=\"shrink-0 text-xs text-muted tabular-nums\">{s.when}</span>\n    </li>\n  </template>\n\n  <!-- A thread: everything about ONE subject, whatever it arrived as. This\n       is the whole of version 2 \u2014 the page is a list of subjects, not a\n       list of sources. -->\n  <template name=\"thread\">\n    <article id=\"th-{t.id}\" tint=\"{t.tint}\" class=\"flex flex-col gap-3 p-4 rounded-2xl bg-surface\">\n      <div class=\"flex items-start gap-3\">\n        <span class=\"size-9 shrink-0 flex items-center justify-center rounded-xl bg-tint-wash\">\n          <img icon=\"{t.icon}\" alt=\"\" class=\"size-4 text-tint\">\n        </span>\n        <div class=\"flex flex-col gap-0.5 min-w-0 flex-1\">\n          <span class=\"text-base font-semibold truncate\">{t.title}</span>\n          <span class=\"text-xs text-secondary line-clamp-2\">{t.state}</span>\n        </div>\n        <span if=\"t.clock\" class=\"shrink-0 px-2.5 py-1 rounded-full text-xs font-semibold bg-tint-wash text-tint tabular-nums\">{t.clock}</span>\n      </div>\n      <ul class=\"flex flex-col\">\n        <use template=\"strand\" each=\"s in t.strands\"></use>\n      </ul>\n      <div class=\"flex items-center gap-2\">\n        <a if=\"t.do\" id=\"do-{t.id}\" action=\"advance\" args=\"id={t.id}\"\n           class=\"h-9 px-4 flex items-center rounded-lg text-xs font-semibold bg-elevated\">{t.do}</a>\n        <a if=\"t.ask\" id=\"ask-{t.id}\" action=\"ask\" args=\"text={t.ask}\"\n           class=\"h-9 px-4 flex items-center rounded-lg text-xs font-medium bg-elevated text-secondary\">{t.ask}</a>\n        <span if=\"t.more\" class=\"ml-auto text-xs text-muted\">{t.more}</span>\n      </div>\n    </article>\n  </template>\n\n  <!-- A loose end: something that belongs to no thread. One line, because\n       that is all it is worth. -->\n  <template name=\"loose\">\n    <li id=\"l-{x.id}\" class=\"flex items-center gap-3 min-h-11 px-4 border-b\">\n      <label class=\"flex items-center gap-3 flex-1 min-w-0\">\n        <span class=\"flex items-center justify-center shrink-0 size-11 -ml-2\">\n          <input type=\"checkbox\" checked=\"{x.done}\" change=\"complete\" args=\"id={x.id}\">\n        </span>\n        <span class=\"flex-1 min-w-0 text-sm truncate\">{x.what}</span>\n      </label>\n      <span if=\"x.late\" class=\"shrink-0 px-2 py-0.5 rounded-full text-xs font-medium bg-danger text-danger tabular-nums\">{x.when}</span>\n      <span if=\"!x.late\" class=\"shrink-0 text-xs text-muted tabular-nums\">{x.when}</span>\n    </li>\n  </template>\n\n  <template name=\"moment\">\n    <li id=\"m-{m.id}\" class=\"flex gap-3\">\n      <span class=\"w-12 shrink-0 pt-0.5 text-right text-xs text-muted tabular-nums\">{m.time}</span>\n      <div class=\"flex flex-col items-center shrink-0 w-3\">\n        <span if=\"!m.free\" tint=\"{m.tint}\" class=\"size-2.5 rounded-full bg-tint\"></span>\n        <span if=\"m.free\" class=\"size-2.5 rounded-full border-2 border-muted\"></span>\n        <span if=\"!m.last\" class=\"w-0.5 flex-1 bg-elevated\"></span>\n      </div>\n      <div class=\"flex flex-col gap-1 min-w-0 flex-1 pb-4\">\n        <span if=\"m.free\" class=\"text-xs text-muted italic\">{m.what}</span>\n        <div if=\"!m.free\" class=\"flex items-center gap-2 min-w-0\">\n          <span if=\"!m.done\" class=\"text-sm truncate\">{m.title}</span>\n          <span if=\"m.done\" class=\"text-sm text-muted truncate\">{m.title}</span>\n          <span if=\"m.live\" class=\"shrink-0 px-2 py-0.5 rounded-full text-xs font-medium bg-accent-wash text-accent\">Now</span>\n        </div>\n        <div if=\"m.leave\" class=\"flex items-center gap-1.5\">\n          <img icon=\"figure.walk\" alt=\"\" tint=\"amber\" class=\"size-3 shrink-0 text-tint\">\n          <span tint=\"amber\" class=\"text-xs text-tint tabular-nums\">{m.leave}</span>\n        </div>\n        <div if=\"m.tight\" class=\"flex items-center gap-1.5\">\n          <img icon=\"exclamationmark.triangle\" alt=\"\" tint=\"red\" class=\"size-3 shrink-0 text-tint\">\n          <span tint=\"red\" class=\"text-xs text-tint\">{m.tight}</span>\n        </div>\n      </div>\n    </li>\n  </template>\n\n  <template name=\"fact\">\n    <li id=\"x-{x.id}\" class=\"flex items-start gap-3 px-4 py-2.5 border-b\">\n      <img icon=\"{x.icon}\" alt=\"\" tint=\"{x.tint}\" class=\"size-4 mt-0.5 shrink-0 text-tint\">\n      <div class=\"flex flex-col gap-0.5 min-w-0 flex-1\">\n        <span class=\"text-sm truncate\">{x.what}</span>\n        <span if=\"x.detail\" class=\"text-xs text-muted line-clamp-2\">{x.detail}</span>\n      </div>\n    </li>\n  </template>\n\n  <div class=\"flex flex-col gap-5 w-full max-w-7xl mx-auto px-5 py-6 lg:px-8\">\n\n    <header id=\"bar\" class=\"flex items-center gap-3\">\n      <div class=\"flex flex-col gap-0.5 min-w-0 flex-1\">\n        <span class=\"text-2xl font-bold truncate\">{greeting}</span>\n        <span class=\"text-sm text-muted truncate\">{date_line}</span>\n      </div>\n      <!-- What changed while you were away. A Today page you check six times\n           a day needs to say what is NEW, or you re-read it six times. -->\n      <a if=\"changed\" id=\"changed\" action=\"show_changed\" tint=\"blue\"\n         class=\"hidden md:flex shrink-0 items-center gap-2 px-3 h-9 rounded-full bg-tint-wash\">\n        <span class=\"size-1.5 rounded-full bg-tint\"></span>\n        <span class=\"text-xs font-medium text-tint\">{changed}</span>\n      </a>\n      <div if=\"weather\" class=\"flex items-center gap-2.5 shrink-0 px-3 h-11 rounded-xl bg-surface\">\n        <img icon=\"{weather.symbol}\" alt=\"{weather.condition}\" tint=\"{weather.tint}\" class=\"size-5 text-tint\">\n        <span class=\"text-base font-semibold tabular-nums\">{weather.temp}</span>\n        <span class=\"hidden md:flex text-xs text-muted tabular-nums\">{weather.range}</span>\n      </div>\n    </header>\n\n    <!-- ===================== THE DAY, AS ONE OBJECT =====================\n         Not a list of rows that happen to be in order: a strip where each\n         block is as wide as it is long, so a 2h review looks like a 2h\n         review and the hole at noon is a hole. The marker underneath is\n         where you are in it. Both come from `grow`, so the shape is the\n         payload's and nothing here computes. -->\n    <section if=\"strip\" id=\"strip\" class=\"flex flex-col gap-1.5\">\n      <div class=\"flex items-stretch gap-1 h-12\">\n        <div each=\"b in strip\" id=\"b-{b.id}\" grow=\"{b.span}\" tint=\"{b.tint}\" class=\"flex min-w-0\">\n          <div if=\"!b.free\" class=\"flex flex-1 items-center px-2.5 rounded-lg overflow-hidden bg-tint-wash\">\n            <span class=\"text-xs font-medium text-tint truncate\">{b.label}</span>\n          </div>\n          <div if=\"b.free\" class=\"flex flex-1 items-center justify-center px-1 overflow-hidden\">\n            <span class=\"text-xs text-muted truncate\">{b.label}</span>\n          </div>\n        </div>\n      </div>\n      <div class=\"flex items-start\">\n        <div grow=\"{at.before}\"></div>\n        <div tint=\"blue\" class=\"flex flex-col items-center shrink-0\">\n          <span class=\"w-0.5 h-3 rounded-full bg-tint\"></span>\n          <span class=\"text-xs font-semibold text-tint tabular-nums\">{at.label}</span>\n        </div>\n        <div grow=\"{at.after}\"></div>\n      </div>\n      <div class=\"flex items-center justify-between\">\n        <span class=\"text-xs text-muted tabular-nums\">{strip_from}</span>\n        <span class=\"text-xs text-secondary\">{strip_note}</span>\n        <span class=\"text-xs text-muted tabular-nums\">{strip_to}</span>\n      </div>\n    </section>\n\n    <div class=\"grid gap-5 lg:grid-cols-[1.45fr_1fr]\">\n\n      <!-- ---------- LEFT: the work, by subject ---------- -->\n      <div class=\"flex flex-col gap-5 min-w-0\">\n\n        <header if=\"now\" id=\"now\" class=\"flex items-start gap-4 p-4 rounded-2xl bg-surface\">\n          <div class=\"flex flex-col gap-0.5 min-w-0 flex-1\">\n            <span class=\"text-xs font-semibold text-accent uppercase\">{now.lead}</span>\n            <span class=\"text-4xl font-bold tabular-nums\">{now.time}</span>\n            <span class=\"text-base text-secondary line-clamp-1\">{now.title}</span>\n            <span if=\"now.where\" class=\"text-xs text-muted truncate\">{now.where}</span>\n          </div>\n          <div class=\"flex flex-col items-end gap-2 shrink-0\">\n            <div if=\"now.faces\" class=\"flex items-center gap-1.5\">\n              <span each=\"f in now.faces\" id=\"nf-{f.id}\" tint=\"{f.tint}\"\n                    class=\"size-8 flex items-center justify-center rounded-full bg-tint-wash\">\n                <span class=\"text-xs font-semibold text-tint\">{f.initials}</span>\n              </span>\n            </div>\n            <a if=\"now.join\" id=\"join\" action=\"join\" shortcut=\"enter\"\n               class=\"h-9 px-4 flex items-center rounded-lg text-xs font-semibold bg-accent text-on-accent\">{now.join}</a>\n          </div>\n        </header>\n\n        <section if=\"threads\" id=\"threads\" class=\"flex flex-col gap-3\">\n          <div class=\"flex items-end justify-between gap-4\">\n            <h2 class=\"text-xs font-semibold text-muted uppercase\">What's live</h2>\n            <span class=\"text-xs text-muted\">{threads_note}</span>\n          </div>\n          <use template=\"thread\" each=\"t in threads\"></use>\n        </section>\n\n      </div>\n\n      <!-- ---------- RIGHT: time, and the world ---------- -->\n      <div class=\"flex flex-col gap-5 min-w-0\">\n\n        <section if=\"rail\" id=\"day\" class=\"flex flex-col gap-3\">\n          <div class=\"flex items-end justify-between gap-4\">\n            <h2 class=\"text-xs font-semibold text-muted uppercase\">The day</h2>\n            <span class=\"text-xs text-muted tabular-nums\">{rail_note}</span>\n          </div>\n          <ul class=\"flex flex-col p-4 pb-0 rounded-2xl bg-surface\">\n            <use template=\"moment\" each=\"m in rail\"></use>\n          </ul>\n        </section>\n\n        <section if=\"loose\" id=\"loose\" class=\"flex flex-col gap-3\">\n          <div class=\"flex items-end justify-between gap-4\">\n            <h2 class=\"text-xs font-semibold text-muted uppercase\">Loose ends</h2>\n            <span class=\"text-xs text-muted tabular-nums\">{loose_note}</span>\n          </div>\n          <ul class=\"flex flex-col rounded-2xl bg-surface overflow-hidden\">\n            <use template=\"loose\" each=\"x in loose\"></use>\n          </ul>\n        </section>\n        <section if=\"house\" id=\"house\" class=\"flex flex-col gap-3\">\n          <h2 class=\"text-xs font-semibold text-muted uppercase\">The house</h2>\n          <ul class=\"flex flex-col rounded-2xl bg-surface overflow-hidden\">\n            <use template=\"fact\" each=\"x in house\"></use>\n          </ul>\n        </section>\n\n        <section if=\"spend\" id=\"spend\" class=\"flex flex-col gap-3\">\n          <h2 class=\"text-xs font-semibold text-muted uppercase\">Spending</h2>\n          <div class=\"flex flex-col gap-3 p-4 rounded-2xl bg-surface\">\n            <div class=\"flex items-end justify-between gap-3\">\n              <span class=\"text-2xl font-bold tabular-nums\">{spend.amount}</span>\n              <span class=\"text-xs text-muted text-right line-clamp-2\">{spend.note}</span>\n            </div>\n            <div tint=\"{spend.tint}\" class=\"flex items-center h-1.5 rounded-full bg-elevated overflow-hidden\">\n              <div grow=\"{spend.used}\" class=\"h-1.5 bg-tint\"></div>\n              <div grow=\"{spend.rest}\" class=\"h-1.5\"></div>\n            </div>\n          </div>\n        </section>\n      </div>\n    </div>\n\n    <section id=\"ask\" class=\"flex flex-col gap-3\">\n      <h2 class=\"text-xs font-semibold text-muted uppercase\">Ask</h2>\n      <div class=\"flex flex-col gap-3 p-4 rounded-2xl bg-surface\">\n        <div class=\"flex flex-wrap items-center gap-2\">\n          <a each=\"s in suggestions\" id=\"sg-{s.id}\" action=\"ask\" args=\"text={s.text}\"\n             class=\"h-9 px-3.5 flex items-center shrink-0 rounded-full text-xs font-medium bg-elevated\">{s.text}</a>\n        </div>\n        <form id=\"compose\" class=\"flex items-center gap-2\">\n          <input bind=\"form.message\" placeholder=\"Ask about today\" class=\"flex-1 h-11 min-w-0\">\n          <button action=\"ask\" shortcut=\"enter\" disabled=\"!$.form.message\"\n                  class=\"shrink-0 h-11 px-5 bg-accent text-on-accent\">Ask</button>\n        </form>\n      </div>\n    </section>\n\n    <footer if=\"keys\" id=\"keys\" class=\"flex flex-wrap items-center gap-x-5 gap-y-2 pb-2\">\n      <div each=\"k in keys\" id=\"k-{k.id}\" class=\"flex items-center gap-1.5\">\n        <span class=\"px-1.5 h-5 flex items-center rounded bg-elevated text-xs font-mono text-secondary\">{k.key}</span>\n        <span class=\"text-xs text-muted\">{k.does}</span>\n      </div>\n    </footer>\n  </div>\n</div>\n",
      "title": "Today \u2014 design study",
      "actions": {}
    }
  },
  "fields": [
    {
      "key": "today_payload",
      "label": "Which sample (ready | evening)",
      "field_type": "text",
      "required": false
    }
  ],
  "entitlements": {
    "settings_read": [
      "today_payload"
    ]
  },
  "app": {
    "repo": "https://github.com/TheBananaStand/leo-today",
    "branch": "design",
    "build": "make",
    "bin": "design/serve-demo",
    "port": 8477,
    "supervised": false
  }
}
