{
  "name": "today",
  "label": "Today",
  "description": "What today holds, at a glance \u2014 the design study, on sample data.",
  "details": "Nothing is live. It serves one sample payload so the markup can be judged in the real app with the platform's own controls, type and spacing.",
  "setup_hint": "Nothing to set up.",
  "icon": "sun.max",
  "category": "package",
  "kind": "app",
  "default_enabled": false,
  "pages": [
    {
      "path": "today",
      "label": "Today",
      "icon": "sun.max",
      "show_in_nav": true
    }
  ],
  "ui": {
    "today": {
      "kind": "html",
      "html": "<div id=\"today\" subset=\"14\" class=\"h-full flex flex-col overflow-y-auto bg-canvas\">\n\n  <!-- ============================ ROW FORMS ============================\n       Every repeated thing on this page is one of five templates. That is\n       the whole consistency rule: a block added next year picks a form, it\n       does not invent one. -->\n\n  <!-- A moment on the day rail. The rail itself is drawn by this row: a dot\n       and a line under it, so the thread is continuous without a single\n       absolutely-placed element. -->\n  <template name=\"moment\">\n    <li id=\"m-{m.id}\" class=\"flex gap-3\">\n      <span class=\"w-14 shrink-0 pt-0.5 text-right text-xs text-muted tabular-nums\">{m.time}</span>\n      <div class=\"flex flex-col items-center shrink-0 w-3\">\n        <!-- Filled for something booked, hollow for an hour nobody has\n             claimed. Same row form either way: a day is its holes too. -->\n        <span if=\"!m.free\" tint=\"{m.tint}\" class=\"size-2.5 rounded-full bg-tint\"></span>\n        <span if=\"m.free\" class=\"size-2.5 rounded-full border-2 border-muted\"></span>\n        <!-- The thread stops at the last moment. A line running on to\n             nothing says there is more below when there is not. -->\n        <span if=\"!m.last\" class=\"w-0.5 flex-1 bg-elevated\"></span>\n      </div>\n      <div class=\"flex flex-col gap-1 min-w-0 flex-1 pb-5\">\n        <span if=\"m.free\" class=\"text-xs text-muted italic\">{m.what}</span>\n        <div if=\"!m.free\" class=\"flex items-center gap-2 min-w-0\">\n          <span if=\"!m.done\" class=\"text-sm font-medium truncate\">{m.title}</span>\n          <span if=\"m.done\" class=\"text-sm text-muted truncate\">{m.title}</span>\n          <span if=\"m.live\" class=\"shrink-0 px-2 py-0.5 rounded-full text-xs font-medium bg-accent-wash text-accent\">Now</span>\n        </div>\n        <div if=\"!m.free\" class=\"flex items-center gap-3 min-w-0\">\n          <span if=\"m.where\" class=\"text-xs text-muted truncate\">{m.where}</span>\n          <span if=\"m.len\" class=\"shrink-0 text-xs text-muted tabular-nums\">{m.len}</span>\n        </div>\n        <!-- Leaving is the thing you get wrong, so it is its own line with\n             the number in it \u2014 on the row it belongs to, not in a banner. -->\n        <div if=\"m.leave\" class=\"flex items-center gap-1.5 pt-0.5\">\n          <img icon=\"figure.walk\" alt=\"\" tint=\"amber\" class=\"size-3.5 shrink-0 text-tint\">\n          <span class=\"text-xs text-tint tabular-nums\" tint=\"amber\">{m.leave}</span>\n        </div>\n        <div if=\"m.faces\" class=\"flex items-center gap-1 pt-0.5\">\n          <span each=\"f in m.faces\" id=\"f-{m.id}-{f.id}\" tint=\"{f.tint}\"\n                class=\"size-6 flex items-center justify-center rounded-full bg-tint-wash\">\n            <span class=\"text-xs font-medium text-tint\">{f.initials}</span>\n          </span>\n        </div>\n      </div>\n    </li>\n  </template>\n\n  <template name=\"task\">\n    <li id=\"t-{t.id}\" class=\"flex items-center gap-2 min-h-11 px-4 border-b\">\n      <label class=\"flex items-center gap-3 flex-1 min-w-0\">\n        <span class=\"flex items-center justify-center shrink-0 size-11 -ml-2\">\n          <input type=\"checkbox\" checked=\"{t.done}\" change=\"complete\" args=\"id={t.id}\">\n        </span>\n        <span class=\"flex-1 min-w-0 text-sm line-clamp-2\">{t.title}</span>\n      </label>\n      <span if=\"t.late\" class=\"shrink-0 px-2 py-0.5 rounded-full text-xs font-medium bg-danger text-danger tabular-nums\">{t.due}</span>\n      <span if=\"!t.late\" class=\"shrink-0 text-xs text-muted tabular-nums\">{t.due}</span>\n    </li>\n  </template>\n\n  <!-- A fact with a hue: a message to answer, something odd at home. One\n       form for both, because they are the same shape of thing \u2014 a glyph, a\n       claim, a detail, a time. -->\n  <template name=\"fact\">\n    <li id=\"x-{x.id}\" class=\"flex items-start gap-3 px-4 py-2.5 border-b\">\n      <img icon=\"{x.icon}\" alt=\"\" tint=\"{x.tint}\" class=\"size-4 mt-0.5 shrink-0 text-tint\">\n      <div class=\"flex flex-col gap-0.5 min-w-0 flex-1\">\n        <span class=\"text-sm truncate\">{x.what}</span>\n        <span if=\"x.detail\" class=\"text-xs text-muted line-clamp-2\">{x.detail}</span>\n      </div>\n      <span if=\"x.when\" class=\"shrink-0 text-xs text-muted tabular-nums\">{x.when}</span>\n    </li>\n  </template>\n\n  <template name=\"note\">\n    <li id=\"n-{n.id}\" class=\"flex items-start gap-3 px-4 py-3 border-b\">\n      <img icon=\"{n.icon}\" alt=\"\" tint=\"{n.tint}\" class=\"size-4 mt-0.5 shrink-0 text-tint\">\n      <div class=\"flex flex-col gap-1 min-w-0 flex-1\">\n        <span class=\"text-sm font-medium line-clamp-2\">{n.title}</span>\n        <span if=\"n.body\" class=\"text-xs text-secondary line-clamp-2\">{n.body}</span>\n      </div>\n      <span class=\"shrink-0 text-xs text-muted tabular-nums\">{n.when}</span>\n    </li>\n  </template>\n\n  <div class=\"flex flex-col gap-6 w-full max-w-7xl mx-auto px-5 py-6 lg:px-8\">\n\n    <!-- ===================== THE BAR =====================\n         Who, when, and what it is like outside \u2014 one line, so the first\n         real thing on the page is the day itself rather than a title. -->\n    <header id=\"bar\" class=\"flex items-center gap-4\">\n      <div class=\"flex flex-col gap-0.5 min-w-0 flex-1\">\n        <span class=\"text-2xl font-bold truncate\">{greeting}</span>\n        <span class=\"text-sm text-muted truncate\">{date_line}</span>\n      </div>\n      <div if=\"weather\" class=\"flex items-center gap-2.5 shrink-0 px-3 h-11 rounded-xl bg-surface\">\n        <img icon=\"{weather.symbol}\" alt=\"{weather.condition}\" tint=\"{weather.tint}\" class=\"size-5 text-tint\">\n        <span class=\"text-base font-semibold tabular-nums\">{weather.temp}</span>\n        <span class=\"hidden md:flex text-xs text-muted tabular-nums\">{weather.range}</span>\n      </div>\n      <a id=\"refresh\" action=\"refresh\" aria-label=\"Refresh today\" shortcut=\"r\"\n         class=\"hidden md:flex shrink-0 size-11 items-center justify-center rounded-xl bg-surface\">\n        <img icon=\"arrow.clockwise\" alt=\"\" class=\"size-4 text-secondary\">\n      </a>\n    </header>\n\n    <!-- How much of the day is behind you. A page about today should say\n         where in today you are. -->\n    <div if=\"arc\" id=\"arc\" tint=\"blue\" class=\"flex items-center gap-3\">\n      <span class=\"text-xs text-muted tabular-nums shrink-0\">{arc.start}</span>\n      <div class=\"flex-1 flex items-center h-1.5 rounded-full bg-elevated overflow-hidden\">\n        <div grow=\"{arc.done}\" tint=\"blue\" class=\"h-1.5 bg-tint\"></div>\n        <div grow=\"{arc.left}\" class=\"h-1.5\"></div>\n      </div>\n      <span class=\"text-xs text-muted tabular-nums shrink-0\">{arc.end}</span>\n    </div>\n\n    <div if=\"focus\" id=\"focus\" tint=\"{focus.tint}\"\n         class=\"flex items-start gap-3 p-4 rounded-2xl bg-surface\">\n      <img icon=\"{focus.icon}\" alt=\"\" class=\"size-5 mt-0.5 shrink-0 text-tint\">\n      <div class=\"flex flex-col gap-1 min-w-0 flex-1\">\n        <span class=\"text-sm font-semibold\">{focus.what}</span>\n        <span class=\"text-xs text-secondary line-clamp-2\">{focus.why}</span>\n      </div>\n      <a if=\"focus.action\" id=\"focus-go\" action=\"focus\" args=\"id={focus.id}\"\n         class=\"shrink-0 h-9 px-4 flex items-center rounded-lg text-xs font-semibold bg-elevated\">{focus.action}</a>\n    </div>\n\n    <!-- ===================== TWO COLUMNS =====================\n         The day on the left, what wants you on the right. One column on a\n         phone; the split arrives at 1024 where there is room for both to\n         keep a readable measure. -->\n    <div class=\"grid gap-6 lg:grid-cols-[1.3fr_1fr]\">\n\n      <!-- ---------- LEFT: the day ---------- -->\n      <div class=\"flex flex-col gap-6 min-w-0\">\n\n        <!-- THE ONE THING: what is happening, or next. Everything else on\n             the page is smaller than this on purpose. -->\n        <header if=\"now\" id=\"now\" class=\"flex flex-col gap-4 p-5 rounded-2xl bg-surface\">\n          <div class=\"flex items-start gap-4\">\n            <div class=\"flex flex-col gap-1 min-w-0 flex-1\">\n              <span class=\"text-xs font-semibold text-accent uppercase\">{now.lead}</span>\n              <span class=\"text-5xl font-bold tabular-nums\">{now.time}</span>\n              <span class=\"text-lg text-secondary line-clamp-2\">{now.title}</span>\n              <span if=\"now.where\" class=\"text-sm text-muted truncate\">{now.where}</span>\n            </div>\n            <div if=\"now.faces\" class=\"flex flex-col items-end gap-2 shrink-0\">\n              <div class=\"flex items-center gap-1.5\">\n                <span each=\"f in now.faces\" id=\"nf-{f.id}\" tint=\"{f.tint}\"\n                      class=\"size-9 flex items-center justify-center rounded-full bg-tint-wash\">\n                  <span class=\"text-xs font-semibold text-tint\">{f.initials}</span>\n                </span>\n              </div>\n              <span class=\"text-xs text-muted truncate\">{now.who}</span>\n            </div>\n          </div>\n\n          <!-- Leaving is the thing you get wrong, so it is a line of its\n               own with the number in it, not a detail in the subtitle. -->\n          <div class=\"flex items-center gap-2\">\n            <a if=\"now.join\" id=\"join\" action=\"join\" shortcut=\"enter\"\n               class=\"h-11 px-5 flex items-center rounded-xl text-sm font-semibold bg-accent text-on-accent\">{now.join}</a>\n            <a id=\"open-cal\" action=\"open_calendar\"\n               class=\"h-11 px-4 flex items-center rounded-xl text-sm font-medium bg-elevated\">Calendar</a>\n          </div>\n        </header>\n\n        <!-- THE RAIL -->\n        <section if=\"rail\" id=\"day\" class=\"flex flex-col gap-3 min-w-0\">\n          <div class=\"flex items-end justify-between gap-4\">\n            <h2 class=\"text-xs font-semibold text-muted uppercase\">The day</h2>\n            <span class=\"text-xs text-muted tabular-nums\">{rail_note}</span>\n          </div>\n          <ul class=\"flex flex-col p-4 pb-0 rounded-2xl bg-surface\">\n            <use template=\"moment\" each=\"m in rail\"></use>\n          </ul>\n        </section>\n\n        <section if=\"tomorrow\" id=\"tomorrow\" class=\"flex flex-col gap-3\">\n          <h2 class=\"text-xs font-semibold text-muted uppercase\">Tomorrow</h2>\n          <div class=\"flex items-center gap-3 px-4 h-14 rounded-2xl bg-surface\">\n            <span class=\"text-sm font-medium tabular-nums shrink-0\">{tomorrow.time}</span>\n            <span class=\"text-sm flex-1 min-w-0 truncate\">{tomorrow.title}</span>\n            <span class=\"text-xs text-muted shrink-0\">{tomorrow.more}</span>\n          </div>\n        </section>\n        <section if=\"notes\" id=\"worth\" class=\"flex flex-col gap-3\">\n          <h2 class=\"text-xs font-semibold text-muted uppercase\">Worth knowing</h2>\n          <ul class=\"flex flex-col rounded-2xl bg-surface overflow-hidden\">\n            <use template=\"note\" each=\"n in notes\"></use>\n          </ul>\n        </section>\n      </div>\n\n      <!-- ---------- RIGHT: what wants you ---------- -->\n      <div class=\"flex flex-col gap-6 min-w-0\">\n\n        <section if=\"tasks\" id=\"doing\" class=\"flex flex-col gap-3\">\n          <div class=\"flex items-end justify-between gap-4\">\n            <h2 class=\"text-xs font-semibold text-muted uppercase\">Needs doing</h2>\n            <span class=\"text-xs text-muted tabular-nums\">{tasks_note}</span>\n          </div>\n          <!-- Done today, as a bar rather than a number: a count tells you\n               nothing without the whole it is out of. -->\n          <div if=\"progress\" class=\"flex items-center gap-3 px-4 h-10 rounded-xl bg-surface\">\n            <div class=\"flex-1 flex items-center h-1.5 rounded-full bg-elevated overflow-hidden\">\n              <div grow=\"{progress.done}\" tint=\"green\" class=\"h-1.5 bg-tint\"></div>\n              <div grow=\"{progress.left}\" class=\"h-1.5\"></div>\n            </div>\n            <span class=\"text-xs text-muted tabular-nums shrink-0\">{progress.label}</span>\n          </div>\n          <ul class=\"flex flex-col rounded-2xl bg-surface overflow-hidden\">\n            <use template=\"task\" each=\"t in tasks\"></use>\n          </ul>\n        </section>\n\n        <section if=\"replies\" id=\"replies\" class=\"flex flex-col gap-3\">\n          <div class=\"flex items-end justify-between gap-4\">\n            <h2 class=\"text-xs font-semibold text-muted uppercase\">Waiting on you</h2>\n            <span class=\"text-xs text-muted tabular-nums\">{replies_note}</span>\n          </div>\n          <ul class=\"flex flex-col rounded-2xl bg-surface overflow-hidden\">\n            <use template=\"fact\" each=\"x in replies\"></use>\n          </ul>\n        </section>\n\n        <section if=\"house\" id=\"house\" class=\"flex flex-col gap-3\">\n          <h2 class=\"text-xs font-semibold text-muted uppercase\">The house</h2>\n          <ul class=\"flex flex-col rounded-2xl bg-surface overflow-hidden\">\n            <use template=\"fact\" each=\"x in house\"></use>\n          </ul>\n        </section>\n\n        <!-- Money as a PACE, not a total: $2,341 means nothing without the\n             week it is two thirds of the way through. -->\n        <section if=\"spend\" id=\"spend\" class=\"flex flex-col gap-3\">\n          <h2 class=\"text-xs font-semibold text-muted uppercase\">Spending</h2>\n          <div class=\"flex flex-col gap-3 p-4 rounded-2xl bg-surface\">\n            <div class=\"flex items-end justify-between gap-3\">\n              <span class=\"text-2xl font-bold tabular-nums\">{spend.amount}</span>\n              <span class=\"text-xs text-muted text-right line-clamp-2\">{spend.note}</span>\n            </div>\n            <div tint=\"{spend.tint}\" class=\"flex items-center h-1.5 rounded-full bg-elevated overflow-hidden\">\n              <div grow=\"{spend.used}\" class=\"h-1.5 bg-tint\"></div>\n              <div grow=\"{spend.rest}\" class=\"h-1.5\"></div>\n            </div>\n            <div class=\"flex items-center justify-between\">\n              <span class=\"text-xs text-muted\">Usual by now</span>\n              <span class=\"text-xs text-muted tabular-nums\">{spend.usual}</span>\n            </div>\n          </div>\n        </section>\n\n      </div>\n    </div>\n\n    <!-- ===================== ASK =====================\n         Full width under both columns: the thread is about the whole page,\n         not about either side of it. -->\n    <section id=\"ask\" class=\"flex flex-col gap-3\">\n      <h2 class=\"text-xs font-semibold text-muted uppercase\">Ask</h2>\n      <div class=\"flex flex-col gap-3 p-4 rounded-2xl bg-surface\">\n        <div class=\"flex flex-wrap items-center gap-2\">\n          <a each=\"s in suggestions\" id=\"s-{s.id}\" action=\"ask\" args=\"text={s.text}\"\n             class=\"h-9 px-3.5 flex items-center shrink-0 rounded-full text-xs font-medium bg-elevated\">{s.text}</a>\n        </div>\n        <form id=\"compose\" class=\"flex items-center gap-2\">\n          <input bind=\"form.message\" placeholder=\"Ask about today\" class=\"flex-1 h-11 min-w-0\">\n          <button action=\"ask\" shortcut=\"enter\" disabled=\"!$.form.message\"\n                  class=\"shrink-0 h-11 px-5 bg-accent text-on-accent\">Ask</button>\n        </form>\n      </div>\n    </section>\n\n    <footer if=\"keys\" id=\"keys\" class=\"flex flex-wrap items-center gap-x-5 gap-y-2 pt-1 pb-2\">\n      <div each=\"k in keys\" id=\"k-{k.id}\" class=\"flex items-center gap-1.5\">\n        <span class=\"px-1.5 h-5 flex items-center rounded bg-elevated text-xs font-mono text-secondary\">{k.key}</span>\n        <span class=\"text-xs text-muted\">{k.does}</span>\n      </div>\n    </footer>\n  </div>\n</div>\n",
      "title": "Today \u2014 design study",
      "actions": {}
    }
  },
  "fields": [
    {
      "key": "today_payload",
      "label": "Which sample (ready | evening)",
      "field_type": "text",
      "required": false
    }
  ],
  "entitlements": {
    "settings_read": [
      "today_payload"
    ]
  },
  "app": {
    "repo": "https://github.com/TheBananaStand/leo-today",
    "branch": "design",
    "build": "make",
    "bin": "design/serve-demo",
    "port": 8477,
    "supervised": false
  }
}
