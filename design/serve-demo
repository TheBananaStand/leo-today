#!/usr/bin/env python3
"""The design study, served as a page.

Nothing is fetched and nothing is live: this answers `/leo/ui/data` with the
sample payload beside it, so the markup can be looked at in the real app with
the real controls, type and spacing. It is a picture you can click.
"""
import json
import os
import pathlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = pathlib.Path(__file__).resolve().parent
PORT = int(os.environ.get("PORT") or os.environ.get("LEO_APP_PORT") or "8478")
WHICH = os.environ.get("today_payload") or "ready"


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def do_GET(self):  # noqa: N802
        path = self.path.split("?")[0]
        if path == "/leo/ui/data":
            name = "evening" if WHICH.strip().lower().startswith("e") else "ready"
            body = (HERE / f"{name}.json").read_bytes()
        elif path in ("/leo/health", "/health"):
            body = b'{"ok":true}'
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *a):
        pass


print(f"today: serving the design study — the {WHICH} payload on :{PORT}", flush=True)
ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
